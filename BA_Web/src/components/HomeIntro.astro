---
import SectionHeader from './SectionHeader.astro';

type Props = {
  approach: string;
};

const { approach } = Astro.props;
---

<section class="ba-section light intro-section">
  <div class="ba-container ba-grid-2">
    <div class="reveal-up">
      <SectionHeader eyebrow="Quiénes somos" title="En Bright Alliance | BA Chile, integramos Derecho, Estrategia y Empresa." lead={approach} />
      <a class="ba-btn ba-btn-outline-dark" href="/nosotros/">Leer más</a>
    </div>
    <div class="intro-panel reveal-up">
      <img src="/assets/office/office-private-room.webp" alt="Oficina Bright Alliance | BA Chile" loading="lazy" />
      <div class="intro-panel__rule"></div>
      <p>Asesoría jurídica con lectura empresarial, diseñada para ordenar decisiones complejas, anticipar riesgos y sostener crecimiento.</p>
      <span>Bright Alliance | BA Chile</span>
    </div>
  </div>
</section>

<style>
  .intro-section {
    position: relative;
    border-bottom: 1px solid var(--ba-gray-200);
  }

  .intro-panel {
    position: relative;
    display: flex;
    min-height: 560px;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    padding: var(--ba-space-8);
    border: 1px solid rgba(16, 47, 75, 0.12);
    background: var(--ba-navy-900);
    color: var(--ba-white);
  }

  .intro-panel::after {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(16, 47, 75, 0.08) 0%, rgba(16, 47, 75, 0.40) 45%, rgba(16, 47, 75, 0.94) 100%),
      linear-gradient(90deg, rgba(16, 47, 75, 0.26), rgba(16, 47, 75, 0));
    content: '';
  }

  .intro-panel img {
    position: absolute;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    margin: 0;
    object-fit: cover;
    opacity: 0.9;
    filter: grayscale(0.08) contrast(1.02);
  }

  .intro-panel__rule {
    position: relative;
    z-index: 1;
    width: 72px;
    height: 3px;
    margin-bottom: var(--ba-space-6);
    background: var(--ba-gold-400);
  }

  .intro-panel p {
    position: relative;
    z-index: 1;
    max-width: 24ch;
    margin: 0;
    color: rgba(255, 255, 255, 0.9);
    font-family: var(--ba-font-head);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.45;
  }

  .intro-panel span {
    position: relative;
    z-index: 1;
    display: block;
    margin-top: var(--ba-space-6);
    color: var(--ba-gold-400);
    font-family: var(--ba-font-head);
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
  }

  @media (max-width: 620px) {
    .intro-panel {
      min-height: 460px;
      padding: var(--ba-space-6);
    }

    .intro-panel img {
      width: 100%;
      height: 100%;
      margin: 0;
    }

    .intro-panel p {
      font-size: 23px;
    }
  }
</style>
