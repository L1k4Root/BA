---
import type { Language } from '../content/site';

type Props = {
  lang?: Language;
  title: string;
  subtitle: string;
  lead?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  image?: string;
  imageAlt?: string;
};

const {
  lang = 'es',
  title,
  subtitle,
  lead,
  primaryHref = lang === 'es' ? '/contacto/' : '/en/contact/',
  primaryLabel = lang === 'es' ? 'Contactar' : 'Contact',
  secondaryHref = lang === 'es' ? '#servicios' : '#services',
  secondaryLabel = lang === 'es' ? 'Ver áreas' : 'View services',
  image = '/assets/hero/santiago-andes-optimized.jpg',
  imageAlt = 'Cordillera de los Andes y skyline de Santiago'
} = Astro.props;
---

<section class="hero">
  <img class="hero__bg" src={image} alt={imageAlt} loading="eager" />
  <div class="hero__overlay"></div>
  <div class="hero__content">
    <span class="ba-label">Bright Alliance · BA Chile</span>
    <h1>{title}</h1>
    <p class="hero__subtitle">{subtitle}</p>
    {lead && <p class="hero__lead">{lead}</p>}
    <div class="hero__actions">
      <a class="ba-btn ba-btn-primary" href={primaryHref}>{primaryLabel}</a>
      <a class="ba-btn ba-btn-secondary" href={secondaryHref}>{secondaryLabel}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: calc(100vh - 116px);
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: var(--ba-space-8) var(--ba-space-6);
    background: var(--ba-navy-900);
    text-align: center;
  }

  .hero__bg,
  .hero__overlay {
    position: absolute;
    inset: 0;
  }

  .hero__bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    transform: scale(1.02);
  }

  .hero__overlay {
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(16, 47, 75, 0.70) 0%, rgba(16, 47, 75, 0.46) 40%, rgba(16, 47, 75, 0.92) 100%),
      radial-gradient(90% 70% at 68% 28%, rgba(179, 146, 89, 0.18) 0%, rgba(16, 47, 75, 0) 62%);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: min(100%, 1120px);
    margin-inline: auto;
  }

  .hero__content .ba-label {
    display: inline-block;
    color: var(--ba-gold-400);
    font-size: clamp(13px, 1.1vw, 16px);
    letter-spacing: 0.30em;
  }

  .hero h1 {
    max-width: 13ch;
    margin: var(--ba-space-5) auto 0;
    color: var(--ba-white);
    font-family: var(--ba-font-head);
    font-size: clamp(48px, 6.4vw, 86px);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1.03;
    text-transform: uppercase;
    text-shadow: 0 24px 52px rgba(0, 0, 0, 0.38);
  }

  .hero__subtitle {
    max-width: 54ch;
    margin: var(--ba-space-5) auto 0;
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(20px, 1.9vw, 28px);
    font-weight: 600;
    line-height: 1.55;
    text-shadow: 0 14px 36px rgba(0, 0, 0, 0.45);
  }

  .hero__lead {
    max-width: 64ch;
    margin: var(--ba-space-5) auto 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: var(--ba-body-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap; 
    justify-content: center;
    gap: var(--ba-space-4);
    margin-top: var(--ba-space-6);
  }

  @media (max-width: 980px) {
    .hero {
      min-height: calc(100vh - 88px);
      padding: var(--ba-space-9) var(--ba-space-5);
    }
  }

  @media (max-width: 620px) {
    .hero {
      min-height: auto;
      padding: var(--ba-space-8) var(--ba-space-4);
      text-align: left;
    }

    .hero__content .ba-label {
      letter-spacing: 0.18em;
    }

    .hero h1,
    .hero__subtitle,
    .hero__lead {
      margin-left: 0;
      margin-right: 0;
    }

    .hero h1 {
      font-size: clamp(36px, 11.5vw, 48px);
    }

    .hero__subtitle {
      font-size: 19px;
      line-height: 1.45;
    }

    .hero__actions {
      justify-content: flex-start;
    }

    .hero__actions .ba-btn {
      width: 100%;
    }
  }
</style>
