---
import type { ServicePage } from '../content/site';

type Props = {
  services: ServicePage[];
  defaultOpenIndex?: number | null;
};

const { services, defaultOpenIndex = 0 } = Astro.props;

const imageForService = (service: ServicePage) => {
  if (service.slug === 'derecho-de-la-empresa') return '/assets/office/office-ba-brand.webp';
  if (service.slug === 'ingenieria-y-derecho') return '/assets/office/office-boardroom-wide.webp';
  if (service.slug === 'comercio-y-negocios-internacionales') return '/assets/hero/chile-puerto-valparaiso.jpg';
  return service.heroImage ?? '/assets/office/office-boardroom-wide.webp';
};

const baseVisual = '/assets/office/office-private-room.webp';
---

<div class="service-accordion" data-service-accordion data-default-open-index={defaultOpenIndex ?? ''}>
  <div class="service-accordion__list">
    {services.map((service, index) => (
      <article class:list={['service-accordion__item', defaultOpenIndex === index && 'is-open']} data-service-item>
        <button
          class="service-accordion__trigger"
          type="button"
          aria-expanded={defaultOpenIndex === index ? 'true' : 'false'}
          data-service-trigger
          data-service-image={imageForService(service)}
          data-service-title={service.navLabel}
        >
          <span>{service.navLabel}</span>
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M5 8l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div class="service-accordion__panel">
          <div class="service-accordion__panel-inner">
            <p>{service.summary}</p>
            <ul>
              {service.areas.slice(0, 4).map((area) => <li>{area}</li>)}
            </ul>
            <a href={`/${service.slug}/`}>Ver especialidad</a>
          </div>
        </div>
      </article>
    ))}
  </div>

  <figure class:list={['service-accordion__visual', defaultOpenIndex === null && 'is-empty']}>
    <img
      class:list={['service-accordion__base', defaultOpenIndex === null && 'is-active']}
      src={baseVisual}
      alt=""
      loading="eager"
      data-service-base
    />
    {services.map((service, index) => (
      <img
        class:list={[defaultOpenIndex === index && 'is-active']}
        src={imageForService(service)}
        alt=""
        loading={index === 0 ? 'eager' : 'lazy'}
        data-service-visual
      />
    ))}
  </figure>
</div>

<script>
  document.querySelectorAll('[data-service-accordion]').forEach((accordion) => {
    const items = Array.from(accordion.querySelectorAll('[data-service-item]'));
    const triggers = Array.from(accordion.querySelectorAll('[data-service-trigger]'));
    const visuals = Array.from(accordion.querySelectorAll('[data-service-visual]'));
    const baseVisual = accordion.querySelector('[data-service-base]');
    const visualFrame = accordion.querySelector('.service-accordion__visual');

    triggers.forEach((trigger, index) => {
      trigger.addEventListener('click', () => {
        const currentItem = items[index];
        const shouldOpen = !currentItem?.classList.contains('is-open');

        items.forEach((item, itemIndex) => {
          const isActive = shouldOpen && itemIndex === index;
          item.classList.toggle('is-open', isActive);
          triggers[itemIndex]?.setAttribute('aria-expanded', String(isActive));
          visuals[itemIndex]?.classList.toggle('is-active', isActive);
        });

        baseVisual?.classList.toggle('is-active', !shouldOpen);
        visualFrame?.classList.toggle('is-empty', !shouldOpen);
      });
    });
  });
</script>

<style>
  .service-accordion {
    display: grid;
    grid-template-columns: minmax(0, 0.96fr) minmax(360px, 0.84fr);
    gap: var(--ba-space-7);
    align-items: stretch;
  }

  .service-accordion__list {
    border-top: 1px solid rgba(16, 47, 75, 0.14);
  }

  .service-accordion__item {
    position: relative;
    border-bottom: 1px solid rgba(16, 47, 75, 0.14);
    background: transparent;
  }

  .service-accordion__item::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 4px;
    background: var(--ba-gold-500);
    content: '';
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left center;
    transition: opacity var(--ba-ease-slow), transform var(--ba-ease-slow);
  }

  .service-accordion__item.is-open::after,
  .service-accordion__item:hover::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .service-accordion__trigger {
    display: flex;
    width: 100%;
    min-height: 88px;
    align-items: center;
    justify-content: space-between;
    gap: var(--ba-space-5);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ba-navy-900);
    cursor: pointer;
    font-family: var(--ba-font-head);
    font-size: 25px;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.22;
    text-align: left;
  }

  .service-accordion__trigger svg {
    width: 22px;
    height: 22px;
    flex: none;
    color: var(--ba-gold-500);
    transition: transform var(--ba-ease-slow);
  }

  .service-accordion__item.is-open .service-accordion__trigger svg {
    transform: rotate(180deg);
  }

  .service-accordion__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--ba-ease-slow);
  }

  .service-accordion__item.is-open .service-accordion__panel {
    grid-template-rows: 1fr;
  }

  .service-accordion__panel-inner {
    overflow: hidden;
  }

  .service-accordion__panel-inner p {
    max-width: 56ch;
    margin: 0 0 var(--ba-space-5);
    color: var(--ba-gray-700);
    font-size: var(--ba-body-md);
  }

  .service-accordion__panel-inner ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--ba-space-3) var(--ba-space-5);
    margin: 0;
    padding: 0 0 var(--ba-space-6);
    list-style: none;
  }

  .service-accordion__panel-inner li {
    position: relative;
    padding-left: 18px;
    color: var(--ba-charcoal);
    font-size: var(--ba-body-sm);
    line-height: 1.5;
  }

  .service-accordion__panel-inner li::before {
    position: absolute;
    top: 0.7em;
    left: 0;
    width: 6px;
    height: 6px;
    background: var(--ba-gold-500);
    content: '';
  }

  .service-accordion__panel-inner a {
    display: inline-flex;
    margin-bottom: var(--ba-space-6);
    padding-bottom: 7px;
    border-bottom: 1px solid rgba(179, 146, 89, 0.6);
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0;
    text-decoration: none;
    text-transform: uppercase;
  }

  .service-accordion__visual {
    position: relative;
    min-height: 520px;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(16, 47, 75, 0.12);
    background: var(--ba-navy-900);
  }

  .service-accordion__visual::before {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    place-items: center;
    padding: var(--ba-space-7);
    color: rgba(255, 255, 255, 0.82);
    content: 'Seleccione una especialidad';
    font-family: var(--ba-font-head);
    font-size: 18px;
    font-weight: 600;
    opacity: 0;
    text-align: center;
    transition: opacity var(--ba-ease-slow);
  }

  .service-accordion__visual.is-empty::before {
    opacity: 1;
  }

  .service-accordion__visual::after {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(180deg, rgba(16, 47, 75, 0.02), rgba(16, 47, 75, 0.18));
    content: '';
  }

  .service-accordion__visual img {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.03);
    transition: opacity var(--ba-ease-slow), transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .service-accordion__visual img.is-active {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .service-accordion__item::after,
    .service-accordion__trigger svg,
    .service-accordion__panel,
    .service-accordion__visual img {
      transition: none;
    }
  }

  @media (max-width: 980px) {
    .service-accordion {
      grid-template-columns: 1fr;
    }

    .service-accordion__visual {
      min-height: 340px;
      order: -1;
    }
  }

  @media (max-width: 620px) {
    .service-accordion__trigger {
      min-height: 76px;
      font-size: 21px;
    }

    .service-accordion__panel-inner ul {
      grid-template-columns: 1fr;
    }
  }
</style>
