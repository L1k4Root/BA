---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CTA from '../components/CTA.astro';
import { articles, services } from '../content/site';

export function getStaticPaths() {
  return [
    ...services.filter((item) => item.lang === 'es').map((page) => ({ params: { slug: page.slug }, props: { page, kind: 'service' } })),
    ...articles.filter((item) => item.lang === 'es').map((page) => ({ params: { slug: page.slug }, props: { page, kind: 'article' } }))
  ];
}

const { page, kind } = Astro.props;
const isArticle = kind === 'article';
---

<BaseLayout title={`${page.title} - Bright Alliance | BA Chile`} description={page.summary} lang="es">
  <section class="ba-section light page-hero">
    <div class="ba-container">
      <SectionHeader eyebrow={isArticle ? page.category : 'Servicio'} title={page.title} lead={page.summary} />
      {!isArticle && <p class="ba-body-lg intro">{page.intro}</p>}
      {!isArticle && <a class="ba-btn ba-btn-primary" href="/contacto/">{page.cta}</a>}
    </div>
  </section>

  {isArticle ? (
    <article class="ba-section offwhite">
      <div class="ba-container-sm article-body">
        <img src={page.image} alt={page.title} />
        {page.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </article>
  ) : (
    <>
      <section class="ba-section offwhite">
        <div class="ba-container ba-grid-2">
          <div>
            <h2 class="ba-heading-xl">Enfoque</h2>
            {page.body.map((paragraph) => <p class="ba-body-lg">{paragraph}</p>)}
          </div>
          {page.models && (
            <div class="model-card">
              <h3>Modalidades de Asesoría</h3>
              <ul class="ba-list">
                {page.models.map((model) => <li>{model}</li>)}
              </ul>
            </div>
          )}
        </div>
      </section>

      <section class="ba-section light">
        <div class="ba-container">
          <SectionHeader eyebrow="Áreas" title={page.slug.includes('landing') ? 'Ámbitos de asesoría' : 'Áreas de especialización'} lead="Materias iniciales organizadas desde la fuente pública y el Brand System." />
          <div class="area-grid">
            {page.areas.map((area, index) => (
              <div class="area-item">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <p>{area}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    </>
  )}

  <CTA title={isArticle ? 'Conversemos sobre el impacto en su empresa' : page.cta} text="Bright Alliance integra Derecho, Estrategia y Empresa para convertir complejidad jurídica en decisiones claras." href="/contacto/" label="Contactar" />
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--ba-space-8);
  }

  .intro {
    max-width: 780px;
    margin: calc(-1 * var(--ba-space-5)) 0 var(--ba-space-6);
  }

  .model-card {
    padding: var(--ba-space-7);
    border-left: 4px solid var(--ba-gold-500);
    background: var(--ba-navy-900);
    color: var(--ba-white);
  }

  .model-card h3 {
    margin: 0 0 var(--ba-space-5);
    color: var(--ba-gold-400);
    font-family: var(--ba-font-head);
    text-transform: uppercase;
  }

  .area-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--ba-space-5);
  }

  .area-item {
    min-height: 150px;
    padding: var(--ba-space-6);
    border: 1px solid var(--ba-gray-200);
    background: var(--ba-white);
  }

  .area-item span {
    display: block;
    margin-bottom: var(--ba-space-4);
    color: var(--ba-gold-500);
    font-family: var(--ba-font-head);
    font-size: 30px;
    font-weight: 900;
    line-height: 1;
  }

  .area-item p {
    margin: 0;
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-weight: 700;
    line-height: 1.35;
  }

  .article-body img {
    width: 100%;
    margin-bottom: var(--ba-space-7);
    border: 1px solid var(--ba-gray-200);
  }

  .article-body p {
    font-size: var(--ba-body-lg);
  }

  @media (max-width: 860px) {
    .area-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
