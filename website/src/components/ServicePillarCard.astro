---
import type { TitlePresentation } from '../content/site';

type Props = {
  index: string;
  title: string;
  text: string;
  titlePresentation?: TitlePresentation;
  titleMinLines?: 1 | 2 | 3 | 4;
};

const { index, title, text, titlePresentation = 'natural', titleMinLines = 2 } = Astro.props;
const titleMinBlockSize = {
  1: '1.28em',
  2: '2.56em',
  3: '3.84em',
  4: '5.12em'
}[titleMinLines];
---

<article
  class:list={['service-pillar-card', titlePresentation === 'uppercase' && 'has-uppercase-title']}
  style={`--pillar-title-min-block: ${titleMinBlockSize}`}
>
  <span class="service-pillar-card__index" aria-hidden="true">{index}</span>
  <h3>{title}</h3>
  <p>{text}</p>
</article>

<style>
  .service-pillar-card {
    display: grid;
    min-height: 100%;
    grid-template-rows: auto auto 1fr;
    gap: var(--ba-space-4);
    padding: var(--ba-space-7);
    border: 1px solid rgba(16, 47, 75, 0.12);
    background: var(--ba-white);
    box-shadow: 0 24px 70px -64px rgba(16, 47, 75, 0.72);
  }

  .service-pillar-card__index {
    color: var(--ba-gold-500);
    font-family: var(--ba-font-head);
    font-size: 24px;
    font-weight: 700;
    line-height: 1;
  }

  .service-pillar-card h3 {
    align-self: start;
    min-block-size: var(--pillar-title-min-block);
    margin: 0;
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-size: var(--ba-heading-md);
    font-weight: 600;
    line-height: 1.28;
    text-transform: none;
  }

  .service-pillar-card.has-uppercase-title h3 {
    text-transform: uppercase;
  }

  .service-pillar-card p {
    align-self: start;
    margin: 0;
    color: var(--ba-gray-700);
  }

  @media (max-width: 980px) {
    .service-pillar-card {
      grid-template-rows: auto auto 1fr;
      padding: var(--ba-space-6);
    }

    .service-pillar-card h3 {
      min-block-size: 0;
    }
  }

  @media (max-width: 620px) {
    .service-pillar-card {
      gap: var(--ba-space-3);
      padding: var(--ba-space-5);
    }

    .service-pillar-card h3 {
      font-size: clamp(20px, 6vw, 25px);
    }
  }
</style>
