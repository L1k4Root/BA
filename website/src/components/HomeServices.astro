---
import SectionHeader from './SectionHeader.astro';
import type { ServicePage } from '../content/site';

type Props = {
  heading: string;
  subheading: string;
  services: ServicePage[];
};

const { heading, subheading, services } = Astro.props;
---

<section class="ba-section offwhite" id="servicios">
  <div class="ba-container">
    <SectionHeader eyebrow="Servicios" title={heading} lead={subheading} />
    <div class="home-service-grid reveal-up">
      {services.slice(0, 3).map((service) => (
        <article class="home-service-card">
          <div class="home-service-card__icon" aria-hidden="true">
            {service.icon === 'engineering' ? (
              <svg viewBox="0 0 32 32">
                <path d="M7 24h18M9 24V11l7-4 7 4v13M12 24v-8h8v8M11 13h10" />
              </svg>
            ) : service.icon === 'international' ? (
              <svg viewBox="0 0 32 32">
                <path d="M16 5a11 11 0 1 0 0 22 11 11 0 0 0 0-22ZM5 16h22M16 5c3 3 4.5 6.7 4.5 11S19 24 16 27M16 5c-3 3-4.5 6.7-4.5 11S13 24 16 27" />
              </svg>
            ) : (
              <svg viewBox="0 0 32 32">
                <path d="M10 9h12M11 9v17h10V9M8 26h16M13 13h6M13 17h6M13 21h6M16 5v4" />
              </svg>
            )}
          </div>
          <span class="ba-label">{service.navLabel}</span>
          <h3>{service.summary}</h3>
          <a href={`/${service.slug}/`}>Ver servicio</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .home-service-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid rgba(16, 47, 75, 0.10);
    background: var(--ba-white);
  }

  .home-service-card {
    display: flex;
    min-height: 316px;
    flex-direction: column;
    padding: clamp(var(--ba-space-6), 4vw, var(--ba-space-8));
    border-right: 1px solid rgba(16, 47, 75, 0.10);
    transition: background var(--ba-ease-slow), box-shadow var(--ba-ease-slow), transform var(--ba-ease-slow);
  }

  .home-service-card:last-child {
    border-right: 0;
  }

  .home-service-card:hover {
    background: #fbfaf7;
    box-shadow: inset 0 -4px 0 var(--ba-gold-500);
    transform: translateY(-2px);
  }

  .home-service-card__icon {
    display: inline-flex;
    width: 108px;
    height: 108px;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--ba-space-6);
    border: 1px solid rgba(179, 146, 89, 0.46);
    background: rgba(179, 146, 89, 0.06);
    color: var(--ba-gold-500);
  }

  .home-service-card__icon svg {
    width: 68px;
    height: 68px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .home-service-card .ba-label {
    color: var(--ba-gold-500);
  }

  .home-service-card h3 {
    margin: var(--ba-space-5) 0 var(--ba-space-6);
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-size: clamp(21px, 1.8vw, 28px);
    font-weight: 700;
    line-height: 1.22;
  }

  .home-service-card a {
    align-self: flex-start;
    margin-top: auto;
    padding-bottom: 7px;
    border-bottom: 1px solid rgba(179, 146, 89, 0.56);
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-service-card {
      transition: none;
    }

    .home-service-card:hover {
      transform: none;
    }
  }

  @media (max-width: 920px) {
    .home-service-grid {
      grid-template-columns: 1fr;
    }

    .home-service-card {
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid rgba(16, 47, 75, 0.10);
    }

    .home-service-card__icon {
      width: 92px;
      height: 92px;
    }

    .home-service-card__icon svg {
      width: 58px;
      height: 58px;
    }

    .home-service-card:last-child {
      border-bottom: 0;
    }
  }
</style>
