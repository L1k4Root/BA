---
import SectionHeader from './SectionHeader.astro';
import type { ServicePage } from '../content/site';

type Props = {
  heading: string;
  subheading: string;
  services: ServicePage[];
};

const { heading, subheading, services } = Astro.props;
---

<section class="ba-section offwhite" id="servicios">
  <div class="ba-container">
    <SectionHeader eyebrow="Servicios" title={heading} lead={subheading} />
    <div class="home-service-grid reveal-up">
      {services.slice(0, 3).map((service) => (
        <article class="home-service-card">
          <div class="home-service-card__icon" aria-hidden="true">
            {service.icon === 'engineering' ? (
              <svg viewBox="0 0 32 32">
                <path d="M7 17h18M9 17c0-4.8 3.1-8 7-8s7 3.2 7 8M16 9v8M12 11.2v4M20 11.2v4" />
                <path d="M10 25h12" />
                <path d="M14 22.5l5.8-5.8M18.4 15.1l3.5 3.5M20.4 13.1l3.5 3.5" />
                <path d="M13 23.8l-1.8-1.8 2.8-2.8 1.8 1.8-2.8 2.8Z" />
              </svg>
            ) : service.icon === 'international' ? (
              <svg viewBox="0 0 32 32">
                <path d="M16 5a11 11 0 1 0 0 22 11 11 0 0 0 0-22ZM5 16h22M16 5c3 3 4.5 6.7 4.5 11S19 24 16 27M16 5c-3 3-4.5 6.7-4.5 11S13 24 16 27" />
              </svg>
            ) : (
              <svg viewBox="0 0 32 32">
                <path d="M8 26h17M10 26V9h10v17M20 14h5v12" />
                <path d="M13 13h4M13 17h4M13 21h4M22 17h1M22 21h1" />
                <path d="M14 9V6h7v3M12 6h11" />
                <path d="M7 20h5v6H7z" />
              </svg>
            )}
          </div>
          <h3>{service.navLabel}</h3>
          <p>{service.summary}</p>
          <a href={`/${service.slug}/`}>Ver servicio</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  #servicios {
    scroll-margin-top: calc(var(--ba-header-compact) + var(--ba-space-5));
  }

  .home-service-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid rgba(16, 47, 75, 0.10);
    background: var(--ba-white);
  }

  .home-service-card {
    display: flex;
    min-height: 390px;
    flex-direction: column;
    padding: clamp(var(--ba-space-6), 3.2vw, var(--ba-space-8));
    border-right: 1px solid rgba(16, 47, 75, 0.10);
    transition: background var(--ba-ease-slow), box-shadow var(--ba-ease-slow), transform var(--ba-ease-slow);
  }

  .home-service-card:last-child {
    border-right: 0;
  }

  .home-service-card:hover {
    background: #fbfaf7;
    box-shadow: inset 0 -4px 0 var(--ba-gold-500);
    transform: translateY(-2px);
  }

  .home-service-card__icon {
    display: inline-flex;
    width: 116px;
    height: 116px;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--ba-space-7);
    border: 1px solid rgba(179, 146, 89, 0.46);
    background: rgba(179, 146, 89, 0.06);
    color: var(--ba-gold-500);
  }

  .home-service-card__icon svg {
    width: 72px;
    height: 72px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .home-service-card h3 {
    margin: 0 0 var(--ba-space-4);
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-size: clamp(20px, 1.45vw, 25px);
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.24;
    text-transform: uppercase;
  }

  .home-service-card p {
    max-width: 31ch;
    margin: 0 0 var(--ba-space-7);
    color: var(--ba-gray-700);
    font-size: clamp(15.5px, 1.05vw, 18px);
    font-weight: 500;
    line-height: 1.58;
  }

  .home-service-card a {
    align-self: flex-start;
    margin-top: auto;
    padding-bottom: 7px;
    border-bottom: 1px solid rgba(179, 146, 89, 0.56);
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-service-card {
      transition: none;
    }

    .home-service-card:hover {
      transform: none;
    }
  }

  @media (max-width: 920px) {
    .home-service-grid {
      grid-template-columns: 1fr;
    }

    .home-service-card {
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid rgba(16, 47, 75, 0.10);
    }

    .home-service-card__icon {
      width: 92px;
      height: 92px;
      margin-bottom: var(--ba-space-5);
    }

    .home-service-card__icon svg {
      width: 58px;
      height: 58px;
    }

    .home-service-card p {
      max-width: 48ch;
    }

    .home-service-card:last-child {
      border-bottom: 0;
    }
  }
</style>
