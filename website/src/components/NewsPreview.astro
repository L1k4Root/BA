---
import SectionHeader from './SectionHeader.astro';
import type { ArticlePage, Language } from '../content/site';
import { routePairs } from '../lib/i18n';

type Props = {
  articles: ArticlePage[];
  lang?: Language;
};

const { articles, lang: requestedLang } = Astro.props;
const lang = requestedLang ?? articles[0]?.lang ?? 'es';
const copy = lang === 'es'
  ? {
      eyebrow: 'Noticias jurídicas',
      title: 'Contingencia legal y empresarial',
      lead: 'Seguimiento de fuentes oficiales relevantes para empresas, regulación y tribunales.',
      source: 'Ver fuente',
      article: 'Leer artículo',
      all: 'Ver todas las noticias'
    }
  : {
      eyebrow: 'Legal news',
      title: 'Legal and business developments',
      lead: 'Monitoring official sources relevant to businesses, regulation, and courts.',
      source: 'View source',
      article: 'Read article',
      all: 'View all news'
    };
---

<section class="ba-section offwhite" id={lang === 'es' ? 'noticias' : 'news'}>
  <div class="ba-container-xl">
    <SectionHeader eyebrow={copy.eyebrow} title={copy.title} lead={copy.lead} />
    <div class="news-grid reveal-up">
      {articles.map((article) => {
        const externalHref = article.externalUrl || (article.kind === 'external' ? article.source?.href : undefined);
        const href = externalHref ?? `${lang === 'en' ? '/en' : ''}/${article.slug}/`;

        return (
          <article class="news-card">
            <div class="news-card__media">
              <img src={article.image} alt={article.title} loading="lazy" />
            </div>
            <div class="news-card__body">
              <span class="ba-label">{article.category}</span>
              <h3 class="ba-heading-md">{article.title}</h3>
              <p>{article.summary}</p>
              {article.source?.label && <span class="news-card__source">{article.source.label}</span>}
              <a href={href} target={externalHref ? '_blank' : undefined} rel={externalHref ? 'noreferrer' : undefined}>
                {externalHref ? copy.source : copy.article}
              </a>
            </div>
          </article>
        );
      })}
    </div>
    <div class="news-preview__actions">
      <a class="ba-btn ba-btn-outline-dark" href={routePairs.news[lang]}>{copy.all}</a>
    </div>
  </div>
</section>

<style>
  #noticias,
  #news {
    scroll-margin-top: calc(var(--ba-header-compact) + var(--ba-space-5));
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--ba-space-4);
    align-items: stretch;
  }

  .news-card {
    display: grid;
    grid-template-rows: auto 1fr;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--ba-gray-200);
    background: var(--ba-white);
    box-shadow: 0 18px 44px -42px rgba(16, 47, 75, 0.45);
    transition: border-color var(--ba-ease-slow), box-shadow var(--ba-ease-slow), transform var(--ba-ease-slow);
  }

  .news-card:hover {
    border-color: rgba(179, 146, 89, 0.46);
    box-shadow: 0 28px 58px -38px rgba(16, 47, 75, 0.52);
    transform: translateY(-4px);
  }

  .news-card__media {
    position: relative;
    overflow: hidden;
    background: var(--ba-navy-900);
  }

  .news-card__media::after {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(16, 47, 75, 0), rgba(16, 47, 75, 0.22)),
      linear-gradient(90deg, rgba(179, 146, 89, 0.12), rgba(179, 146, 89, 0));
    content: '';
    opacity: 0.45;
    transition: opacity var(--ba-ease-slow);
  }

  .news-card:hover .news-card__media::after {
    opacity: 0.18;
  }

  .news-card img {
    width: 100%;
    aspect-ratio: 5 / 3;
    object-fit: cover;
    transform: scale(1.01);
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1), filter var(--ba-ease-slow);
  }

  .news-card:hover img {
    filter: contrast(1.05) saturate(1.04);
    transform: scale(1.06);
  }

  .news-card__body {
    display: flex;
    flex-direction: column;
    padding: var(--ba-space-4);
  }

  .news-card .ba-label {
    color: var(--ba-gold-500);
  }

  .news-card h3 {
    margin: var(--ba-space-3) 0;
    font-size: clamp(16px, 1.12vw, 19px);
    line-height: 1.25;
  }

  .news-card p {
    margin: 0 0 var(--ba-space-4);
    font-size: 14px;
    line-height: 1.45;
  }

  .news-card__source {
    display: block;
    margin-bottom: var(--ba-space-4);
    color: var(--ba-gray-700);
    font-family: var(--ba-font-head);
    font-size: 12px;
    font-weight: 600;
  }

  .news-card a {
    position: relative;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    align-self: flex-start;
    margin-top: auto;
    padding: 8px 0;
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .news-card a::after {
    position: absolute;
    right: 0;
    bottom: 4px;
    left: 0;
    height: 1px;
    background: var(--ba-gold-500);
    content: '';
    transform: scaleX(0.28);
    transform-origin: left center;
    transition: transform var(--ba-ease-slow);
  }

  .news-card:hover a::after {
    transform: scaleX(1);
  }

  .news-preview__actions {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--ba-space-6);
  }

  @media (prefers-reduced-motion: reduce) {
    .news-card,
    .news-card img,
    .news-card__media::after,
    .news-card a::after {
      transition: none;
    }

    .news-card:hover {
      transform: none;
    }
  }

  @media (max-width: 1120px) {
    .news-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .news-grid {
      grid-template-columns: 1fr;
      gap: var(--ba-space-4);
    }

    .news-card__body {
      padding: var(--ba-space-4);
    }

    .news-card .ba-label,
    .news-card__source {
      font-size: 12px;
      line-height: 1.35;
    }

    .news-card h3 {
      font-size: 18px;
    }

    .news-card p {
      font-size: 15px;
    }

    .news-card a {
      font-size: 12px;
    }

    .news-preview__actions,
    .news-preview__actions .ba-btn {
      width: 100%;
    }
  }
</style>
