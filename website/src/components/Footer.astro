---
import Logo from './Logo.astro';
import type { Language } from '../content/site';
import { contact, servicesByLang } from '../content/site';

type Props = {
  lang?: Language;
};

const { lang = 'es' } = Astro.props;
const serviceItems = servicesByLang(lang).filter((item) => !item.slug.startsWith('landing') && item.slug !== 'compliance').slice(0, 3);
const isEs = lang === 'es';
---

<footer class="footer" id="contacto">
  <div class="footer__top">
    <div>
      <Logo variant="white" />
      <p>{isEs ? 'Asesoría jurídico-estratégica para empresas, proyectos y operaciones complejas.' : 'Strategic legal advisory for companies, projects, and complex operations.'}</p>
    </div>

    <div>
      <h2>{isEs ? 'Servicios' : 'Services'}</h2>
      {serviceItems.map((service) => (
        <a href={`${lang === 'en' ? '/en/' : '/'}${service.slug}/`}>{service.navLabel}</a>
      ))}
    </div>

    <div>
      <h2>{isEs ? 'Contacto' : 'Contact'}</h2>
      <p>{contact.address}</p>
      <a href={`mailto:${contact.email}`}>{contact.email}</a>
      <a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a>
      <div class="footer__social">
        <a href={contact.linkedin} aria-label="LinkedIn Bright Alliance" target="_blank" rel="noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6.94 8.96H3.72V20h3.22V8.96ZM5.34 4a1.86 1.86 0 1 0 0 3.72A1.86 1.86 0 0 0 5.34 4Zm14.94 9.95c0-3.22-1.72-5.29-4.53-5.29-1.78 0-2.74.98-3.2 1.67V8.96H9.46V20h3.22v-5.48c0-1.45.27-2.85 2.07-2.85 1.77 0 1.8 1.66 1.8 2.94V20h3.23v-6.05h.5Z" fill="currentColor" />
          </svg>
        </a>
      </div>
    </div>
  </div>
  <div class="footer__bottom">
    <span>© 2026 Bright Alliance Chile | {isEs ? 'Despacho de Abogados para empresas y comercio | Santiago de Chile' : 'Law Firm for Businesses and Commerce | Santiago, Chile'}</span>
    <a class="footer__credit" href="https://automize.cl/" target="_blank" rel="noreferrer">
      {isEs ? 'Desarrollado por Automize.cl' : 'Developed by Automize.cl'}
    </a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    background-color: var(--ba-navy-900);
    background-image: linear-gradient(180deg, var(--ba-navy-900), #0b2338);
    color: var(--ba-white);
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.4fr;
    gap: var(--ba-space-8);
    width: min(calc(100% - 40px), var(--ba-container-lg));
    margin-inline: auto;
    padding: var(--ba-space-9) 0 var(--ba-space-7);
  }

  .footer h2 {
    margin: 0 0 var(--ba-space-5);
    color: var(--ba-gold-500);
    font-family: var(--ba-font-head);
    font-size: var(--ba-label);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer p,
  .footer a {
    color: rgba(255, 255, 255, 0.78);
    font-size: var(--ba-body-sm);
    line-height: 1.55;
  }

  .footer p {
    max-width: 36ch;
    margin: var(--ba-space-5) 0 0;
  }

  .footer a {
    display: block;
    margin-bottom: var(--ba-space-3);
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--ba-gold-400);
  }

  .footer__social {
    display: flex;
    gap: var(--ba-space-3);
    margin-top: var(--ba-space-5);
  }

  .footer__social a {
    display: inline-flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.28);
    color: var(--ba-white);
    font-family: var(--ba-font-head);
    font-weight: 700;
  }

  .footer__social svg {
    width: 22px;
    height: 22px;
  }

  .footer__social a:hover {
    border-color: var(--ba-gold-500);
    background: var(--ba-gold-500);
    color: var(--ba-navy-900);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--ba-space-3);
    padding: var(--ba-space-5) var(--ba-space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(8, 24, 38, 0.24);
    color: rgba(255, 255, 255, 0.72);
    font-size: 13px;
    line-height: 1.6;
    text-align: center;
  }

  .footer__bottom .footer__credit {
    display: inline-flex;
    margin: 0;
    color: var(--ba-gold-400);
    font-family: var(--ba-font-head);
    font-size: 13px;
    font-weight: 700;
  }

  .footer__bottom .footer__credit:hover {
    color: var(--ba-white);
  }

  @media (max-width: 860px) {
    .footer__top {
      grid-template-columns: 1fr;
    }
  }
</style>
