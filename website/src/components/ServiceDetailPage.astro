---
import ContentAccordionGroup from './ContentAccordionGroup.astro';
import SectionHeader from './SectionHeader.astro';
import ServicePillarGrid from './ServicePillarGrid.astro';
import type { Language, ServicePage } from '../content/site';

type Props = {
  page: ServicePage;
  lang?: Language;
};

const { page, lang = 'es' } = Astro.props;
const isEnglish = lang === 'en';
const isCorporate = page.translationKey === 'service-corporate-business-law';
const isEngineering = page.translationKey === 'service-engineering-and-law';
const isInternational = page.translationKey === 'service-international-trade-business';
const bodyBelongsBelowHero = isCorporate || isInternational;
const serviceOpening = !bodyBelongsBelowHero ? page.body[0] : '';
const serviceBody = bodyBelongsBelowHero ? page.body : page.body.slice(1);
const hasServiceBody = serviceBody.length > 0;
const hasServiceIntroMedia = isInternational && Boolean(page.supportImage);
const serviceIntroTitle = isInternational
  ? (isEnglish ? 'Connecting companies, markets, and opportunities' : 'Conectando empresas, mercados y oportunidades')
  : isCorporate
    ? ''
    : (isEnglish ? 'Our pillars' : 'Nuestros pilares');
const labels = isEnglish
  ? {
      models: 'Advisory Models',
      pillars: 'Our pillars',
      criteria: 'Working criteria',
      practice: 'A practice oriented toward business decisions',
      practiceLead: 'Each service line is organized from a legal, strategic, and operational perspective.',
      scope: 'Scope',
      content: 'Service content',
      contentLead: "Summary adapted from BA Chile's current public information.",
      areas: 'Areas',
      advisoryScopes: 'Advisory scopes',
      specialization: 'Areas of specialization',
      areasLead: 'Matters organized for executive and actionable reading.'
    }
  : {
      models: 'Modalidades de Asesoría',
      pillars: 'Nuestros pilares',
      criteria: 'Criterio de trabajo',
      practice: 'Una práctica orientada a decisiones empresariales',
      practiceLead: 'Cada línea de servicio se organiza desde una lectura legal, estratégica y operativa.',
      scope: 'Alcance',
      content: 'Contenido del servicio',
      contentLead: 'Síntesis adaptada desde la información pública vigente de BA Chile.',
      areas: 'Áreas',
      advisoryScopes: 'Ámbitos de asesoría',
      specialization: 'Áreas de especialización',
      areasLead: 'Materias organizadas para una lectura ejecutiva y accionable.'
    };
const areaAccordionEntries = page.areas.map((area) => typeof area === 'string'
  ? { title: area }
  : {
      title: area.title,
      text: area.text,
      items: area.items,
      titlePresentation: area.titlePresentation
    });
---

<section class="service-hero">
  <img class="service-hero__image" src={page.heroImage || '/assets/office/office-private-room.webp'} alt={`Bright Alliance | BA Chile - ${page.navLabel}`} />
  <div class="service-hero__overlay"></div>
  <div class="ba-container service-hero__content">
    <h1>{page.title}</h1>
    <p class="service-hero__summary">{page.summary}</p>
    {page.intro && <p class="service-hero__intro">{page.intro}</p>}
    {serviceOpening && <p class="service-hero__body">{serviceOpening}</p>}
  </div>
</section>

{hasServiceBody && (
  <section class="ba-section light">
    <div class:list={['ba-container', page.models ? 'ba-grid-2' : 'service-copy', hasServiceIntroMedia && 'service-copy--with-media']}>
      <div class="service-copy__text">
        {serviceIntroTitle && <h2 class="ba-heading-xl">{serviceIntroTitle}</h2>}
        {serviceBody.map((paragraph) => <p class="ba-body-lg">{paragraph}</p>)}
      </div>
      {page.models && (
        <div class="model-card">
          <h3>{labels.models}</h3>
          <ul class="ba-list">
            {page.models.map((model) => <li>{model}</li>)}
          </ul>
        </div>
      )}
      {hasServiceIntroMedia && (
        <figure class="service-copy__media">
          <img src={page.supportImage} alt={`Bright Alliance | BA Chile - ${page.navLabel}`} loading="lazy" />
        </figure>
      )}
    </div>
  </section>
)}

{page.pillars && (
  <section class="ba-section offwhite service-pillars">
    <div class="ba-container">
      {isCorporate ? (
        <>
          <div class="service-pillars__intro service-pillars__intro--criteria-first">
            <SectionHeader eyebrow={labels.criteria} title={labels.practice} lead={labels.practiceLead} />
            <figure class="service-pillars__media">
              <img src={page.supportImage || page.heroImage || '/assets/office/office-boardroom-wide.webp'} alt={`${labels.criteria} - ${page.navLabel}`} loading="lazy" />
            </figure>
          </div>
          <div class="service-pillars__cards service-pillars__cards--after-intro">
            <ServicePillarGrid pillars={page.pillars} titleMinLines={page.pillarTitleMinLines} />
          </div>
        </>
      ) : (
        <>
          <h2 class="ba-heading-xl service-pillars__heading">{labels.pillars}</h2>
          <div class="service-pillars__cards">
            <ServicePillarGrid pillars={page.pillars} titleMinLines={page.pillarTitleMinLines} />
          </div>
          <div class="service-pillars__intro">
            <SectionHeader eyebrow={labels.criteria} title={labels.practice} lead={labels.practiceLead} />
            <figure class="service-pillars__media">
              <img src={page.supportImage || page.heroImage || '/assets/office/office-boardroom-wide.webp'} alt={`${labels.criteria} - ${page.navLabel}`} loading="lazy" />
            </figure>
          </div>
        </>
      )}
    </div>
  </section>
)}

{page.sections && (
  <section class="ba-section light service-detail">
    <div class="ba-container">
      {!isEngineering && <SectionHeader eyebrow={labels.scope} title={labels.content} lead={labels.contentLead} />}
      <div class="service-detail__list">
        {page.sections.map((section, index) => (
          <article class:list={['detail-item', isEngineering && 'detail-item--no-index']}>
            {!isEngineering && <span>{String(index + 1).padStart(2, '0')}</span>}
            <div>
              <h3>{section.href ? <a href={section.href}>{section.title}</a> : section.title}</h3>
              <p>{section.text}</p>
              {section.paragraphs && section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {section.subsectionsLabel && <p class="nested-item__label">{section.subsectionsLabel}</p>}
              {section.subsections && (
                <div class="service-detail__accordion">
                  <ContentAccordionGroup entries={section.subsections} variant="compact" headingLevel={4} />
                </div>
              )}
              {section.items && (
                <ul class="ba-list">
                  {section.items.map((item) => <li>{item}</li>)}
                </ul>
              )}
              {section.result && <p class="detail-item__result">{section.result}</p>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{page.areas.length > 0 && (
  <section class="ba-section offwhite">
    <div class="ba-container">
      <SectionHeader eyebrow={labels.areas} title={page.slug.includes('landing') ? labels.advisoryScopes : labels.specialization} lead={labels.areasLead} />
      <ContentAccordionGroup entries={areaAccordionEntries} />
    </div>
  </section>
)}

<style>
  .service-hero {
    position: relative;
    display: grid;
    min-height: 720px;
    overflow: hidden;
    color: var(--ba-white);
  }

  .service-hero__image,
  .service-hero__overlay {
    position: absolute;
    inset: 0;
  }

  .service-hero__image {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .service-hero__overlay {
    background:
      linear-gradient(90deg, rgba(5, 14, 23, 0.72) 0%, rgba(16, 47, 75, 0.50) 46%, rgba(16, 47, 75, 0.32) 100%),
      linear-gradient(180deg, rgba(5, 14, 23, 0.22) 0%, rgba(5, 14, 23, 0.54) 100%);
  }

  .service-hero__content {
    position: relative;
    z-index: 1;
    align-self: center;
    padding-top: var(--ba-header-expanded);
  }

  .service-hero h1 {
    max-width: 920px;
    margin: 0 0 var(--ba-space-5);
    color: var(--ba-white);
    font-family: var(--ba-font-head);
    font-size: var(--ba-display-xl);
    font-weight: 700;
    line-height: 1.08;
  }

  .service-hero__summary {
    max-width: 760px;
    margin: 0 0 var(--ba-space-4);
    color: var(--ba-white);
    font-family: var(--ba-font-head);
    font-size: clamp(19px, 1.65vw, 25px);
    font-weight: 700;
    line-height: 1.45;
  }

  .service-hero__intro {
    max-width: 900px;
    margin: 0 0 var(--ba-space-4);
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(17px, 1.35vw, 21px);
    line-height: 1.65;
  }

  .service-hero__body {
    max-width: 900px;
    margin: 0;
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(17px, 1.25vw, 20px);
    line-height: 1.65;
  }

  .service-copy {
    max-width: 980px;
  }

  .service-copy--with-media {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(360px, 1fr);
    gap: var(--ba-space-8);
    align-items: center;
    max-width: var(--ba-container-lg);
  }

  .service-copy--with-media .service-copy__text p + p,
  .ba-grid-2 .service-copy__text p + p {
    margin-top: var(--ba-space-4);
  }

  .model-card {
    padding: var(--ba-space-7);
    border-left: 4px solid var(--ba-gold-500);
    background: var(--ba-navy-900);
    color: var(--ba-white);
    box-shadow: 0 28px 70px -50px rgba(16, 47, 75, 0.72);
  }

  .model-card .ba-list li {
    margin-bottom: var(--ba-space-4);
    color: rgba(255, 255, 255, 0.88);
    font-family: var(--ba-font-head);
    font-weight: 600;
  }

  .model-card h3 {
    margin: 0 0 var(--ba-space-5);
    color: var(--ba-gold-400);
    font-family: var(--ba-font-head);
    text-transform: uppercase;
  }

  .service-pillars__heading {
    margin: 0 0 var(--ba-space-7);
  }

  .service-pillars__intro {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(360px, 1fr);
    gap: var(--ba-space-8);
    align-items: end;
    margin-top: var(--ba-space-8);
  }

  .service-pillars__intro :global(.section-header) {
    margin-bottom: 0;
  }

  .service-pillars__intro--criteria-first {
    margin-top: 0;
  }

  .service-pillars__cards--after-intro {
    margin-top: var(--ba-space-8);
  }

  .service-pillars__media,
  .service-copy__media {
    position: relative;
    min-height: 300px;
    margin: 0;
    overflow: hidden;
    border-left: 4px solid var(--ba-gold-500);
    background: var(--ba-navy-900);
    box-shadow: 0 28px 80px -56px rgba(16, 47, 75, 0.72);
  }

  .service-pillars__media::after,
  .service-copy__media::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(16, 47, 75, 0.04), rgba(16, 47, 75, 0.22));
    content: '';
  }

  .service-pillars__media img,
  .service-copy__media img {
    width: 100%;
    height: 100%;
    min-height: 300px;
    max-width: none;
    object-fit: cover;
    filter: saturate(0.82) contrast(1.03);
  }

  .service-detail__list {
    display: grid;
    gap: var(--ba-space-5);
  }

  .detail-item {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: var(--ba-space-5);
    padding: var(--ba-space-7);
    border-top: 1px solid var(--ba-gray-200);
    background: linear-gradient(180deg, rgba(16, 47, 75, 0.018), rgba(16, 47, 75, 0));
  }

  .detail-item--no-index {
    grid-template-columns: minmax(0, 1fr);
  }

  .detail-item > span {
    color: var(--ba-gold-500);
    font-family: var(--ba-font-head);
    font-size: 24px;
    font-weight: 700;
  }

  .detail-item h3 {
    margin: var(--ba-space-4) 0 var(--ba-space-3);
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-size: var(--ba-heading-md);
    font-weight: 600;
  }

  .detail-item h3 a {
    color: inherit;
    text-decoration-color: var(--ba-gold-500);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .detail-item p {
    margin: 0;
  }

  .detail-item .ba-list {
    margin-top: var(--ba-space-5);
  }

  .detail-item__result {
    margin-top: var(--ba-space-5) !important;
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-weight: 600;
  }

  .nested-item__label {
    margin-top: var(--ba-space-6) !important;
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-weight: 700;
  }

  .service-detail__accordion {
    margin-top: var(--ba-space-4);
  }

  @media (max-width: 860px) {
    .service-copy--with-media,
    .service-pillars__intro {
      grid-template-columns: 1fr;
    }

    .detail-item {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .service-hero {
      min-height: 640px;
    }

    .detail-item {
      padding: var(--ba-space-5);
    }

    .service-copy__media,
    .service-copy__media img {
      min-height: 240px;
    }

    .service-hero h1 {
      font-size: 40px;
    }

    .service-hero__summary {
      font-size: 19px;
    }
  }
</style>
