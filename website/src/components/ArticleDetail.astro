---
import type { ArticlePage, Language } from '../content/site';

type Props = {
  page: ArticlePage;
  lang?: Language;
};

const { page, lang = 'es' } = Astro.props;
const isEs = lang === 'es';
---

<article class="article-detail">
  <section class="article-detail__hero">
    <div class="ba-container article-detail__hero-grid">
      <div class="article-detail__intro">
        <span class="ba-label ba-eyebrow">{page.category}</span>
        <h1>{page.title}</h1>
        <p>{page.summary}</p>
        <div class="article-detail__meta" aria-label={isEs ? 'Metadatos del artículo' : 'Article metadata'}>
          {page.publishedAt && <span>{page.publishedAt}</span>}
          {page.readTime && <span>{page.readTime}</span>}
          {page.source && <a href={page.source.href} target="_blank" rel="noreferrer">{page.source.label}</a>}
        </div>
        {page.externalUrl && <a class="ba-btn ba-btn-primary article-detail__source-link" href={page.externalUrl} target="_blank" rel="noreferrer">{isEs ? 'Ver fuente original' : 'View original source'}</a>}
      </div>
      <figure class="article-detail__media">
        <img src={page.image} alt={page.title} />
      </figure>
    </div>
  </section>

  <section class="ba-section light">
    <div class="ba-container article-detail__content-grid">
      <aside class="article-detail__side">
        <h2>{isEs ? 'Claves para revisar' : 'Key review points'}</h2>
        <ul>
          {(page.keyPoints ?? []).map((point) => <li>{point}</li>)}
        </ul>
      </aside>

      <div class="article-detail__body">
        <div class="article-detail__lead">
          {page.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        {(page.sections ?? []).map((section, index) => (
          <section class="article-detail__section">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.items && (
              <ul class="ba-list">
                {section.items.map((item) => <li>{item}</li>)}
              </ul>
            )}
          </section>
        ))}
      </div>
    </div>
  </section>
</article>

<style>
  .article-detail__hero {
    padding: var(--ba-page-top-offset) 0 var(--ba-space-9);
    background:
      linear-gradient(180deg, rgba(16, 47, 75, 0.04), rgba(16, 47, 75, 0)),
      var(--ba-white);
  }

  .article-detail__hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(360px, 0.84fr);
    gap: var(--ba-space-8);
    align-items: end;
  }

  .article-detail__intro h1 {
    max-width: 13ch;
    margin: var(--ba-space-5) 0 0;
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-size: 52px;
    font-weight: 700;
    line-height: 1.06;
  }

  .article-detail__intro > p {
    max-width: 58ch;
    margin: var(--ba-space-5) 0 0;
    color: var(--ba-gray-700);
    font-size: var(--ba-body-lg);
  }

  .article-detail__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ba-space-3);
    margin-top: var(--ba-space-6);
  }

  .article-detail__meta span,
  .article-detail__meta a {
    border: 1px solid rgba(16, 47, 75, 0.16);
    padding: 8px 12px;
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0;
    text-decoration: none;
    text-transform: uppercase;
  }

  .article-detail__meta a {
    border-color: rgba(179, 146, 89, 0.55);
    color: var(--ba-gold-500);
  }

  .article-detail__source-link {
    margin-top: var(--ba-space-6);
  }

  .article-detail__media {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid rgba(16, 47, 75, 0.14);
    background: var(--ba-navy-900);
  }

  .article-detail__media::after {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 108px;
    height: 4px;
    background: var(--ba-gold-500);
    content: '';
  }

  .article-detail__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.02) saturate(1.02);
  }

  .article-detail__content-grid {
    display: grid;
    grid-template-columns: minmax(220px, 0.34fr) minmax(0, 0.82fr);
    gap: var(--ba-space-8);
    align-items: start;
  }

  .article-detail__side {
    position: sticky;
    top: 112px;
    border-top: 4px solid var(--ba-gold-500);
    padding: var(--ba-space-6);
    background: var(--ba-offwhite);
  }

  .article-detail__side h2 {
    margin: 0 0 var(--ba-space-5);
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .article-detail__side ul {
    display: grid;
    gap: var(--ba-space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-detail__side li {
    color: var(--ba-charcoal);
    font-size: var(--ba-body-sm);
  }

  .article-detail__body {
    display: grid;
    gap: var(--ba-space-8);
  }

  .article-detail__lead {
    border-bottom: 1px solid var(--ba-gray-200);
    padding-bottom: var(--ba-space-7);
  }

  .article-detail__lead p,
  .article-detail__section p {
    margin: 0 0 var(--ba-space-5);
    color: var(--ba-gray-700);
    font-size: var(--ba-body-lg);
    line-height: 1.7;
  }

  .article-detail__section {
    position: relative;
    padding-left: var(--ba-space-7);
  }

  .article-detail__section > span {
    position: absolute;
    top: 0;
    left: 0;
    color: var(--ba-gold-500);
    font-family: var(--ba-font-head);
    font-size: 20px;
    font-weight: 700;
  }

  .article-detail__section h2 {
    margin: 0 0 var(--ba-space-4);
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-size: 30px;
    font-weight: 700;
    line-height: 1.2;
  }

  .article-detail__section .ba-list {
    margin-top: var(--ba-space-5);
  }

  @media (max-width: 980px) {
    .article-detail__hero-grid,
    .article-detail__content-grid {
      grid-template-columns: 1fr;
    }

    .article-detail__side {
      position: static;
    }
  }

  @media (max-width: 620px) {
    .article-detail__intro h1 {
      max-width: none;
      font-size: 38px;
    }

    .article-detail__section {
      padding-left: 0;
    }

    .article-detail__section > span {
      position: static;
      display: block;
      margin-bottom: var(--ba-space-3);
    }
  }
</style>
