---
import { NEWS_DRAFT_STORAGE_KEY, draftToArticleExample } from '../../lib/newsDraftContract';

const storageKey = NEWS_DRAFT_STORAGE_KEY;
---

<section class="news-draft">
  <div class="news-draft__intro">
    <p class="ba-label ba-eyebrow">Dev interno</p>
    <h1 class="ba-heading-xl">Agregador MVP de noticias</h1>
    <p>
      Esta ruta permite crear borradores locales mientras corre el servidor de desarrollo.
      Hoy persiste en el navegador; el contrato queda listo para moverlo a una API o CMS.
    </p>
  </div>

  <form class="news-draft__form" data-news-draft-form>
    <label>
      Título
      <input name="title" required placeholder="Nueva actualización regulatoria..." />
    </label>
    <label>
      Slug
      <input name="slug" placeholder="se-genera-automaticamente" />
    </label>
    <label>
      Categoría
      <input name="category" required value="Regulación" />
    </label>
    <label>
      Resumen
      <textarea name="summary" required rows="3" placeholder="Bajada editorial breve."></textarea>
    </label>
    <div class="news-draft__grid">
      <label>
        Fuente
        <input name="sourceLabel" placeholder="CMF, BCN, Diario Oficial..." />
      </label>
      <label>
        URL fuente
        <input name="sourceHref" type="url" placeholder="https://..." />
      </label>
    </div>
    <label>
      Cuerpo
      <textarea name="body" required rows="8" placeholder="Un párrafo por línea."></textarea>
    </label>
    <div class="news-draft__actions">
      <button class="ba-btn ba-btn-primary" type="submit">Guardar draft</button>
      <button class="ba-btn ba-btn-outline-dark" type="button" data-news-draft-export>Exportar JSON</button>
      <button class="ba-btn ba-btn-outline-dark" type="button" data-news-draft-clear>Limpiar</button>
    </div>
  </form>

  <div class="news-draft__output">
    <div>
      <h2 class="ba-heading-md">Drafts locales</h2>
      <p data-news-draft-count>0 borradores</p>
    </div>
    <div class="news-draft__list" data-news-draft-list></div>
    <pre data-news-draft-json aria-label="JSON de borradores">[]</pre>
  </div>

  <details class="news-draft__contract">
    <summary>Contrato para persistencia futura</summary>
    <pre>{draftToArticleExample}</pre>
    <p>
      Persistencia sugerida: `POST /api/news-drafts` con validación de DTO y escritura en CMS,
      base de datos o PR automatizado sobre `src/content/site.ts`.
    </p>
  </details>
</section>

<script define:vars={{ storageKey }}>
  const form = document.querySelector('[data-news-draft-form]');
  const list = document.querySelector('[data-news-draft-list]');
  const output = document.querySelector('[data-news-draft-json]');
  const count = document.querySelector('[data-news-draft-count]');
  const exportButton = document.querySelector('[data-news-draft-export]');
  const clearButton = document.querySelector('[data-news-draft-clear]');

  const slugify = (value) =>
    value
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '');

  const escapeHtml = (value) =>
    String(value).replace(/[&<>"']/g, (character) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;'
    }[character]));

  const readDrafts = () => {
    try {
      return JSON.parse(localStorage.getItem(storageKey) || '[]');
    } catch {
      return [];
    }
  };

  const writeDrafts = (drafts) => {
    localStorage.setItem(storageKey, JSON.stringify(drafts, null, 2));
  };

  const renderDrafts = () => {
    const drafts = readDrafts();
    count.textContent = `${drafts.length} ${drafts.length === 1 ? 'borrador' : 'borradores'}`;
    output.textContent = JSON.stringify(drafts, null, 2);
    list.innerHTML = drafts.map((draft) => `
      <article class="news-draft-card">
        <span>${escapeHtml(draft.category)}</span>
        <h3>${escapeHtml(draft.title)}</h3>
        <p>${escapeHtml(draft.summary)}</p>
        <small>${escapeHtml(draft.slug)}</small>
      </article>
    `).join('');
  };

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const title = String(data.get('title') || '').trim();
    const slug = String(data.get('slug') || '').trim() || slugify(title);
    const draft = {
      id: crypto.randomUUID(),
      title,
      slug,
      summary: String(data.get('summary') || '').trim(),
      category: String(data.get('category') || '').trim(),
      sourceLabel: String(data.get('sourceLabel') || '').trim(),
      sourceHref: String(data.get('sourceHref') || '').trim(),
      body: String(data.get('body') || '').trim(),
      createdAt: new Date().toISOString()
    };

    writeDrafts([draft, ...readDrafts()]);
    form.reset();
    renderDrafts();

    /*
      Persistencia futura:
      await fetch('/api/news-drafts', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(draft)
      });
    */
  });

  exportButton?.addEventListener('click', async () => {
    await navigator.clipboard?.writeText(output.textContent || '[]');
    exportButton.textContent = 'JSON copiado';
    window.setTimeout(() => {
      exportButton.textContent = 'Exportar JSON';
    }, 1400);
  });

  clearButton?.addEventListener('click', () => {
    localStorage.removeItem(storageKey);
    renderDrafts();
  });

  renderDrafts();
</script>

<style>
  .news-draft {
    display: grid;
    gap: var(--ba-space-7);
  }

  .news-draft__intro {
    max-width: 760px;
  }

  .news-draft__intro h1 {
    margin: var(--ba-space-4) 0;
  }

  .news-draft__form,
  .news-draft__output,
  .news-draft__contract {
    border: 1px solid rgba(16, 47, 75, 0.14);
    background: var(--ba-white);
    padding: var(--ba-space-6);
  }

  .news-draft__form {
    display: grid;
    gap: var(--ba-space-5);
  }

  .news-draft__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--ba-space-5);
  }

  .news-draft label {
    display: grid;
    gap: var(--ba-space-2);
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-size: 13px;
    font-weight: 700;
  }

  .news-draft input,
  .news-draft textarea {
    width: 100%;
    border: 1px solid rgba(16, 47, 75, 0.18);
    border-radius: 0;
    padding: 13px 14px;
    color: var(--ba-charcoal);
    font: 500 15px/1.5 var(--ba-font-body);
  }

  .news-draft textarea {
    resize: vertical;
  }

  .news-draft__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ba-space-3);
  }

  .news-draft__output {
    display: grid;
    gap: var(--ba-space-5);
  }

  .news-draft__output > div:first-child {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--ba-space-4);
  }

  .news-draft__output h2,
  .news-draft__output p {
    margin: 0;
  }

  .news-draft__list {
    display: grid;
    gap: var(--ba-space-3);
  }

  .news-draft-card {
    border-left: 4px solid var(--ba-gold-500);
    background: var(--ba-offwhite);
    padding: var(--ba-space-4);
  }

  .news-draft-card span,
  .news-draft-card small {
    color: var(--ba-gold-500);
    font-family: var(--ba-font-head);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .news-draft-card h3 {
    margin: var(--ba-space-2) 0;
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
  }

  .news-draft-card p {
    margin: 0 0 var(--ba-space-2);
  }

  .news-draft pre {
    overflow: auto;
    margin: 0;
    background: #0f263d;
    color: var(--ba-white);
    padding: var(--ba-space-5);
    font-size: 13px;
    line-height: 1.55;
  }

  .news-draft__contract summary {
    cursor: pointer;
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-weight: 700;
  }

  .news-draft__contract pre {
    margin: var(--ba-space-5) 0;
  }

  @media (max-width: 760px) {
    .news-draft__grid {
      grid-template-columns: 1fr;
    }

    .news-draft__form,
    .news-draft__output,
    .news-draft__contract {
      padding: var(--ba-space-5);
    }
  }
</style>
