---
type Locale = 'es' | 'en';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = locale === 'es'
  ? {
      title: 'Contacto',
      name: 'Nombre',
      email: 'Correo electrónico',
      message: 'Mensaje o motivo de contacto',
      privacy: 'En Bright Alliance utilizaremos tus datos de contacto sólo para comunicarnos contigo.',
      submit: 'Enviar',
      submitting: 'Enviando…',
      success: 'Mensaje enviado correctamente. Nos pondremos en contacto contigo.',
      invalid: 'Revisa los campos indicados e intenta nuevamente.',
      rateLimited: 'Se alcanzó el límite de envíos. Intenta nuevamente en unos minutos.',
      failure: 'No fue posible enviar el mensaje. Intenta nuevamente o escríbenos a contacto@bachile.cl.',
    }
  : {
      title: 'Contact',
      name: 'Name',
      email: 'Email',
      message: 'Message or reason for contact',
      privacy: 'At Bright Alliance, we will use your contact information solely to communicate with you.',
      submit: 'Send',
      submitting: 'Sending…',
      success: 'Message sent successfully. We will contact you shortly.',
      invalid: 'Review the highlighted fields and try again.',
      rateLimited: 'The submission limit has been reached. Please try again in a few minutes.',
      failure: 'We could not send your message. Please try again or email contacto@bachile.cl.',
    };
---

<form
  id="contact-form"
  class="contact-form"
  action="/api/contact.php"
  method="post"
  data-contact-form
  data-message-success={copy.success}
  data-message-invalid={copy.invalid}
  data-message-rate-limited={copy.rateLimited}
  data-message-failure={copy.failure}
>
  <h2>{copy.title}</h2>
  <input type="hidden" name="locale" value={locale} />
  <div class="contact-honeypot" aria-hidden="true" inert>
    <label>
      Website
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>
  <label>
    {copy.name}
    <input type="text" name="name" autocomplete="name" minlength="1" maxlength="120" required />
  </label>
  <label>
    {copy.email}
    <input type="email" name="email" autocomplete="email" maxlength="254" required />
  </label>
  <label>
    {copy.message}
    <textarea name="message" rows="6" minlength="1" maxlength="5000" required></textarea>
  </label>
  <p>{copy.privacy}</p>
  <p class="contact-form__status" aria-live="polite" data-contact-status></p>
  <p id="contact-status-sent" class="contact-form__fallback-status">{copy.success}</p>
  <p id="contact-status-invalid" class="contact-form__fallback-status">{copy.invalid}</p>
  <p id="contact-status-rate-limited" class="contact-form__fallback-status">{copy.rateLimited}</p>
  <p id="contact-status-failed" class="contact-form__fallback-status">{copy.failure}</p>
  <button
    class="ba-btn ba-btn-primary"
    type="submit"
    data-submit-label={copy.submit}
    data-submit-pending={copy.submitting}
  >
    {copy.submit}
  </button>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.reportValidity() || form.getAttribute('aria-busy') === 'true') {
        return;
      }

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const status = form.querySelector<HTMLElement>('[data-contact-status]');
      if (!button || !status) {
        return;
      }

      const defaultLabel = button.dataset.submitLabel ?? button.textContent ?? '';
      button.disabled = true;
      button.textContent = button.dataset.submitPending ?? defaultLabel;
      form.setAttribute('aria-busy', 'true');
      status.textContent = '';
      status.dataset.state = '';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: {
            Accept: 'application/json',
          },
        });
        const payload = await response.json().catch(() => null) as { code?: string } | null;

        if (!response.ok) {
          if (response.status === 400) {
            status.textContent = form.dataset.messageInvalid ?? '';
          } else if (response.status === 429) {
            status.textContent = form.dataset.messageRateLimited ?? '';
          } else {
            status.textContent = form.dataset.messageFailure ?? '';
          }
          status.dataset.state = 'error';
          return;
        }

        if (payload?.code !== 'sent') {
          throw new Error('Unexpected contact endpoint response');
        }

        form.reset();
        status.textContent = form.dataset.messageSuccess ?? '';
        status.dataset.state = 'success';
      } catch {
        status.textContent = form.dataset.messageFailure ?? '';
        status.dataset.state = 'error';
      } finally {
        button.disabled = false;
        button.textContent = defaultLabel;
        form.removeAttribute('aria-busy');
      }
    });
  });
</script>

<style>
  .contact-form {
    display: grid;
    gap: var(--ba-space-5);
    scroll-margin-top: calc(var(--ba-header-compact) + var(--ba-space-4));
    padding: var(--ba-space-7);
    border: 1px solid var(--ba-gray-200);
    background: var(--ba-white);
    box-shadow: 0 30px 70px -56px rgba(16, 47, 75, 0.72);
  }

  .contact-form h2 {
    margin: 0;
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
  }

  .contact-form label {
    display: grid;
    gap: var(--ba-space-2);
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    border: 1px solid var(--ba-gray-200);
    padding: 14px 16px;
    color: var(--ba-gray-700);
    font: inherit;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    border-color: var(--ba-gold-500);
    outline: 2px solid rgba(179, 146, 89, 0.18);
    outline-offset: 0;
  }

  .contact-form p {
    margin: 0;
    color: var(--ba-gray-700);
    font-size: var(--ba-body-sm);
  }

  .contact-form button:disabled {
    cursor: wait;
    opacity: 0.7;
  }

  .contact-form__status {
    min-height: 1.5em;
  }

  .contact-form__status[data-state='success'],
  .contact-form__fallback-status:target {
    color: #1c6b42;
  }

  .contact-form__status[data-state='error'] {
    color: #a12929;
  }

  .contact-form__fallback-status {
    display: none;
  }

  .contact-form__fallback-status:target {
    display: block;
  }

  .contact-honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
