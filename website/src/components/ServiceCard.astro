---
type Props = {
  index?: string;
  title: string;
  description: string;
  href?: string;
  ctaLabel?: string;
  variant?: 'light' | 'dark';
};

const { index, title, description, href, ctaLabel = 'Leer más', variant = 'light' } = Astro.props;
---

<article class:list={['service-card', variant === 'dark' && 'is-dark']}>
  {index && <span class="service-card__index">{index}</span>}
  <h3 class="ba-heading-md">{title}</h3>
  <p>{description}</p>
  {href && <a href={href}>{ctaLabel}</a>}
</article>

<style>
  .service-card {
    position: relative;
    display: flex;
    min-height: 100%;
    flex-direction: column;
    gap: var(--ba-space-5);
    padding: var(--ba-space-8) var(--ba-space-7);
    border: 0;
    border-right: 1px solid rgba(16, 47, 75, 0.10);
    background: var(--ba-white);
    transition: background 240ms ease, box-shadow 240ms ease;
  }

  .service-card:last-child {
    border-right: 0;
  }

  .service-card::before {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    width: auto;
    height: 4px;
    background: var(--ba-gold-500);
    content: '';
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left center;
    transition: opacity 240ms ease, transform 240ms ease;
  }

  .service-card:hover {
    background: #fbfaf7;
    box-shadow: inset 0 0 0 1px rgba(179, 146, 89, 0.26);
  }

  .service-card:hover::before {
    opacity: 1;
    transform: scaleX(1);
  }

  .service-card.is-dark {
    background: var(--ba-white);
    color: var(--ba-navy-900);
  }

  .service-card__index {
    color: var(--ba-gold-500);
    font-family: var(--ba-font-head);
    font-size: 18px;
    font-weight: 600;
    line-height: 1;
  }

  .service-card h3 {
    margin: 0;
    max-width: 15ch;
    font-size: 26px;
  }

  .service-card.is-dark h3 {
    color: var(--ba-navy-900);
  }

  .service-card p {
    margin: 0;
    color: var(--ba-gray-700);
    font-size: var(--ba-body-md);
  }

  .service-card.is-dark p {
    color: var(--ba-gray-700);
  }

  .service-card a {
    align-self: flex-start;
    margin-top: auto;
    padding-bottom: 7px;
    border-bottom: 1px solid rgba(179, 146, 89, 0.48);
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0;
    text-decoration: none;
    text-transform: uppercase;
  }

  .service-card.is-dark a {
    border-color: rgba(179, 146, 89, 0.48);
    color: var(--ba-navy-900);
  }

  @media (max-width: 980px) {
    .service-card {
      border-right: 0;
      border-bottom: 1px solid rgba(16, 47, 75, 0.10);
      padding: var(--ba-space-7);
    }

    .service-card:last-child {
      border-bottom: 0;
    }
  }
</style>
