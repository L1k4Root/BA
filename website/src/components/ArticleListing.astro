---
import type { ArticlePage } from '../content/site';

type Props = {
  articles: ArticlePage[];
  variant: 'external' | 'internal';
};

const { articles, variant } = Astro.props;
const isExternal = variant === 'external';
---

<div class="article-list">
  {articles.map((article) => (
    <article class:list={['article-card', !isExternal && 'article-card--internal']}>
      <img src={article.image} alt={article.title} loading="lazy" />
      <div class="article-card__content">
        <span class="ba-label">{article.category}</span>
        <h2 class="ba-heading-md">{article.title}</h2>
        <p>{article.summary}</p>
        {isExternal && article.source?.label && <span class="article-card__source">{article.source.label}</span>}
        {isExternal ? (
          <a href={article.externalUrl || article.source?.href} target="_blank" rel="noreferrer">Ver fuente</a>
        ) : (
          <a href={`/${article.slug}/`}>Ver estructura</a>
        )}
      </div>
    </article>
  ))}
</div>

<style>
  .article-list {
    display: grid;
    gap: var(--ba-space-6);
  }

  .article-card {
    display: grid;
    grid-template-columns: minmax(240px, 0.42fr) minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid var(--ba-gray-200);
    background: var(--ba-white);
    box-shadow: 0 24px 72px -64px rgba(16, 47, 75, 0.52);
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .article-card:hover {
    border-color: rgba(181, 143, 81, 0.46);
    box-shadow: 0 32px 76px -58px rgba(16, 47, 75, 0.68);
    transform: translateY(-2px);
  }

  .article-card img {
    width: 100%;
    height: 100%;
    min-height: 260px;
    max-width: none;
    object-fit: cover;
  }

  .article-card__content {
    padding: var(--ba-space-7);
  }

  .article-card .ba-label {
    color: var(--ba-gold-500);
  }

  .article-card h2 {
    margin: var(--ba-space-3) 0;
  }

  .article-card p {
    margin: 0 0 var(--ba-space-4);
  }

  .article-card__source {
    display: block;
    margin-bottom: var(--ba-space-5);
    color: var(--ba-gray-700);
    font-family: var(--ba-font-head);
    font-size: 13px;
    font-weight: 600;
  }

  .article-card a {
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    text-transform: uppercase;
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }

  .article-card a:hover,
  .article-card a:focus-visible {
    color: var(--ba-gold-600);
    text-decoration-color: currentColor;
  }

  @media (prefers-reduced-motion: reduce) {
    .article-card {
      transition: none;
    }

    .article-card:hover {
      transform: none;
    }
  }

  @media (max-width: 760px) {
    .article-card {
      grid-template-columns: 1fr;
    }

    .article-card img {
      min-height: 220px;
      aspect-ratio: 16 / 9;
    }

    .article-card__content {
      padding: var(--ba-space-5);
    }
  }
</style>
