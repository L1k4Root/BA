---
import '../styles/global.css';

type ReviewPage = {
  label: string;
  path: string;
};

type Props = {
  title: string;
  note: string;
  sourceBase: string;
  reviewPages: ReviewPage[];
};

const { title, note, sourceBase, reviewPages } = Astro.props;
const normalizedBase = sourceBase.replace(/\/$/, '');
const resolveSource = (pathname: string) => `${normalizedBase}${pathname}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="description" content="Vista interna para comparar una versión anterior del sitio Bright Alliance." />
    <link rel="icon" type="image/svg+xml" href="/assets/brand-source/logo-ba.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="review-toolbar">
      <div class="review-toolbar__title">
        <strong>{title}</strong>
        <span>{note}</span>
      </div>

      <nav class="review-toolbar__nav" aria-label="Páginas de la versión anterior">
        {reviewPages.map((page, index) => (
          <a
            class:list={['review-link', index === 0 && 'is-active']}
            href={resolveSource(page.path)}
            target="legacy-review-frame"
            data-review-link
          >
            {page.label}
          </a>
        ))}
      </nav>

      <a class="review-open" href={resolveSource(reviewPages[0].path)} target="_blank" rel="noreferrer" data-open-source>
        Abrir aparte
      </a>
    </header>

    <main class="review-frame-shell">
      <iframe
        class="review-frame"
        name="legacy-review-frame"
        title={title}
        src={resolveSource(reviewPages[0].path)}
        loading="eager"
      ></iframe>
    </main>

    <script is:inline>
      const links = [...document.querySelectorAll('[data-review-link]')];
      const openSource = document.querySelector('[data-open-source]');

      for (const link of links) {
        link.addEventListener('click', () => {
          for (const item of links) item.classList.remove('is-active');
          link.classList.add('is-active');
          if (openSource) openSource.href = link.href;
        });
      }
    </script>
  </body>
</html>

<style>
  :global(html),
  :global(body) {
    height: 100%;
    margin: 0;
  }

  :global(body) {
    overflow: hidden;
    background: #e9edf0;
  }

  .review-toolbar {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) minmax(520px, 2fr) auto;
    gap: 20px;
    align-items: center;
    min-height: 88px;
    padding: 14px 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    background: #102f4b;
    color: #fff;
    box-shadow: 0 12px 30px rgba(5, 14, 23, 0.18);
  }

  .review-toolbar__title {
    display: grid;
    gap: 4px;
  }

  .review-toolbar__title strong {
    font-family: var(--ba-font-head);
    font-size: 16px;
  }

  .review-toolbar__title span {
    color: rgba(255, 255, 255, 0.72);
    font-size: 12px;
    line-height: 1.4;
  }

  .review-toolbar__nav {
    display: flex;
    gap: 8px;
    align-items: center;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .review-link,
  .review-open {
    flex: 0 0 auto;
    border: 1px solid rgba(255, 255, 255, 0.26);
    color: #fff;
    font-family: var(--ba-font-head);
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  .review-link {
    padding: 11px 12px;
    background: rgba(255, 255, 255, 0.06);
  }

  .review-link:hover,
  .review-link:focus-visible,
  .review-link.is-active {
    border-color: #bd9756;
    background: #bd9756;
    color: #102f4b;
  }

  .review-open {
    padding: 12px 14px;
    border-color: #bd9756;
    color: #e1c58d;
  }

  .review-frame-shell {
    height: calc(100vh - 88px);
  }

  .review-frame {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
  }

  @media (max-width: 980px) {
    .review-toolbar {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 10px 14px;
      min-height: 128px;
      padding: 12px 14px;
    }

    .review-toolbar__title span {
      display: none;
    }

    .review-toolbar__nav {
      grid-column: 1 / -1;
      grid-row: 2;
      order: 3;
    }

    .review-frame-shell {
      height: calc(100vh - 128px);
    }
  }

  @media (max-width: 520px) {
    .review-toolbar {
      min-height: 122px;
    }

    .review-toolbar__title strong {
      font-size: 13px;
    }

    .review-open {
      padding: 10px;
      font-size: 10px;
    }

    .review-link {
      padding: 10px;
      font-size: 10px;
    }

    .review-frame-shell {
      height: calc(100vh - 122px);
    }
  }
</style>
