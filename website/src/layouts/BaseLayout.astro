---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import type { Language } from '../content/site';
import { getAlternateLinks, getCanonicalUrl, SITE_ORIGIN } from '../lib/i18n';

type Props = {
  title: string;
  description?: string;
  lang?: Language;
};

const {
  title,
  description = 'Bright Alliance | BA Chile integra Derecho, Estrategia y Empresa para ofrecer asesoría jurídico-estratégica a empresas.',
  lang = 'es'
} = Astro.props;

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/en/';
const site = Astro.site ?? new URL(SITE_ORIGIN);
const canonicalUrl = getCanonicalUrl(Astro.url.pathname, site);
const alternateLinks = getAlternateLinks(Astro.url.pathname, site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18330419853"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'AW-18330419853');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {alternateLinks.map((alternate) => (
      <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />
    ))}
    <link rel="icon" type="image/svg+xml" href="/assets/brand-source/logo-ba.svg" />
    <title>{title}</title>
  </head>
  <body>
    <Header lang={lang} tone="navy" overlay={isHome} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
