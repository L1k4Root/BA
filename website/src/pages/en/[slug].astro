---
import ArticleDetail from '../../components/ArticleDetail.astro';
import CTA from '../../components/CTA.astro';
import ServiceDetailPage from '../../components/ServiceDetailPage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles, contact, services } from '../../content/site';

export function getStaticPaths() {
  return [
    ...services
      .filter((item) => item.lang === 'en')
      .map((page) => ({ params: { slug: page.slug }, props: { page, kind: 'service' } })),
    ...articles
      .filter((item) => item.lang === 'en')
      .map((page) => ({ params: { slug: page.slug }, props: { page, kind: 'article' } }))
  ];
}

const { page, kind } = Astro.props;
const isArticle = kind === 'article';
const ctaTitle = isArticle ? 'Let us discuss the impact on your company' : page.cta;
const ctaText = isArticle
  ? 'Bright Alliance integrates Law, Strategy, and Business to turn legal complexity into clear decisions.'
  : page.ctaText ?? 'Bright Alliance integrates Law, Strategy, and Business to turn legal complexity into clear decisions.';
---

<BaseLayout title={`${page.title} - Bright Alliance | BA Chile`} description={page.summary} lang="en">
  {isArticle ? <ArticleDetail page={page} lang="en" /> : <ServiceDetailPage page={page} lang="en" />}

  <CTA title={ctaTitle} text={ctaText} href="/en/contact/" label="Contact" agendaHref={contact.agendaHref} lang="en" />
</BaseLayout>
