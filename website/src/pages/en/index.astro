---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import HomeIntro from '../../components/HomeIntro.astro';
import HomeServices from '../../components/HomeServices.astro';
import ClientTrustMarquee from '../../components/ClientTrustMarquee.astro';
import NewsPreview from '../../components/NewsPreview.astro';
import FounderQuote from '../../components/FounderQuote.astro';
import CTA from '../../components/CTA.astro';
import { clientLogos, contact, externalNews, home, servicesByLang } from '../../content/site';

const lang = 'en';
const content = home[lang];
const services = servicesByLang(lang);
const articles = externalNews.filter((article) => article.lang === lang).slice(0, 4);
---

<BaseLayout title="Home - Bright Alliance | BA Chile" description={content.lead} lang={lang}>
  <Hero
    lang={lang}
    title={content.title}
    subtitle={content.subtitle}
    primaryLabel="View practice areas"
    primaryHref="#services"
    secondaryLabel="Let us talk"
    secondaryHref="/en/contact/"
  />

  <HomeIntro approach={content.approach} secondary={content.approachFollowup} lang={lang} />

  <HomeServices heading={content.servicesHeading} subheading={content.servicesSubheading} services={services} lang={lang} />

  <ClientTrustMarquee logos={clientLogos} lang={lang} />

  <NewsPreview articles={articles} lang={lang} />

  <FounderQuote heading={content.founderHeading} quote={content.founderQuote} text={content.founderText} />

  <CTA
    title="Let us discuss your next project"
    text="We organize contracts, risks, compliance, and critical decisions with legal judgment and business vision."
    href="/en/contact/"
    label="Contact"
    agendaHref={contact.agendaHref}
    lang={lang}
  />
</BaseLayout>
