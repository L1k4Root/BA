---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ContactForm from '../../components/ContactForm.astro';
import { contact } from '../../content/site';
---

<BaseLayout title="Contact - Bright Alliance | BA Chile" description="Contact Bright Alliance | BA Chile." lang="en">
  <section class="ba-section light contact-hero">
    <div class="ba-container ba-grid-2 contact-grid">
      <div class="contact-copy">
        <SectionHeader level="h1" eyebrow="Contact" title="/ Contact" lead="Let us discuss your business concerns or the next project you need to organize from a legal perspective." />
        <ul class="ba-list">
          <li>Address: {contact.addressEn ?? contact.address}</li>
          <li>Email: <a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          <li>Phone: <a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a></li>
        </ul>
        <div class="contact-actions">
          <a class="ba-btn ba-btn-primary" href="#contact-form">Contact now</a>
          <a class="ba-btn ba-btn-agenda" href={contact.agendaHref}>Schedule</a>
        </div>
        <figure class="contact-media">
          <img src="/assets/office/office-boardroom-wide.webp" alt="Bright Alliance | BA Chile meeting room" loading="lazy" />
        </figure>
      </div>
      <ContactForm locale="en" />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    align-items: start;
  }

  .contact-copy .ba-list {
    max-width: 62ch;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ba-space-3);
    margin-top: var(--ba-space-6);
  }

  .ba-btn-agenda {
    border-color: var(--ba-gold-500);
    background: var(--ba-gold-500);
    color: var(--ba-navy-900);
  }

  .contact-media {
    position: relative;
    margin: var(--ba-space-8) 0 0;
    overflow: hidden;
    border: 1px solid var(--ba-gray-200);
    aspect-ratio: 16 / 9;
  }

  .contact-media::after {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 96px;
    height: 4px;
    background: var(--ba-gold-500);
    content: '';
  }

  .contact-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
