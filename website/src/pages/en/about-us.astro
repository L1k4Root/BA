---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import CTA from '../../components/CTA.astro';
import { about } from '../../content/site';

const content = about.en;
---

<BaseLayout title="About Us - Bright Alliance | BA Chile" description={content.lead} lang="en">
  <section class="ba-section light page-hero">
    <div class="ba-container ba-grid-2">
      <div>
        <SectionHeader eyebrow="Firm" title={content.title} lead={content.lead} />
        <a class="ba-btn ba-btn-primary" href="/en/contact/">Contact</a>
      </div>
      <div class="ba-frame portrait">
        <img src="/assets/website/jose-francisco-mazzei.png" alt="José Francisco Mazzei Alliende" />
      </div>
    </div>
  </section>

  <section class="ba-section offwhite">
    <div class="ba-container">
      <div class="ba-grid-2">
        <div>
          <h2 class="ba-heading-xl">Our Proposal</h2>
          {content.proposal.map((paragraph) => <p class="ba-body-lg">{paragraph}</p>)}
        </div>
        <div class="mission-card">
          <h3>Mission</h3>
          <p>{content.mission}</p>
          <h3>Vision</h3>
          <p>{content.vision}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="ba-section light">
    <div class="ba-container">
      <SectionHeader eyebrow="Values" title="Our Values" lead="Principles that shape client relationships, projects, and decisions." />
      <div class="ba-grid-3">
        {content.values.map((value) => <div class="value-card">{value}</div>)}
      </div>
    </div>
  </section>

  <CTA title="Let us discuss your legal need" text="BA Chile works with a technical, sober, and business-oriented advisory logic." href="/en/contact/" label="Contact" />
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--ba-space-8);
  }

  .portrait {
    aspect-ratio: 1 / 1;
  }

  .mission-card {
    padding: var(--ba-space-7);
    border-left: 4px solid var(--ba-gold-500);
    background: var(--ba-navy-900);
    color: var(--ba-white);
  }

  .mission-card h3 {
    margin: 0 0 var(--ba-space-3);
    color: var(--ba-gold-400);
    font-family: var(--ba-font-head);
    text-transform: uppercase;
  }

  .mission-card p {
    margin: 0 0 var(--ba-space-6);
  }

  .value-card {
    padding: var(--ba-space-6);
    border: 1px solid var(--ba-gray-200);
    background: var(--ba-white);
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-weight: 800;
    text-transform: uppercase;
  }
</style>
