---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import CTA from '../../components/CTA.astro';
import { about, contact } from '../../content/site';

const content = about.en;
---

<BaseLayout title="About Us - Bright Alliance | BA Chile" description={content.lead} lang="en">
  <section class="ba-section light page-hero">
    <div class="ba-container ba-grid-2">
      <div>
        <SectionHeader level="h1" eyebrow="Firm" title={content.title} lead={content.lead} />
        <a class="ba-btn ba-btn-outline-dark" href="/en/contact/">Contact</a>
      </div>
      <div class="ba-frame portrait">
        <img src="/assets/office/office-lounge-wide.webp" alt="Bright Alliance | BA Chile office" />
      </div>
    </div>
  </section>

  <section class="ba-section offwhite">
    <div class="ba-container">
      <div class="ba-grid-2">
        <div>
          <h2 class="ba-heading-xl">Our Proposal</h2>
          {content.proposal.map((paragraph) => <p class="ba-body-lg">{paragraph}</p>)}
        </div>
        <div class="mission-card">
          <h3>Mission</h3>
          <p>{content.mission}</p>
          <h3>Vision</h3>
          <p>{content.vision}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="ba-section light values-section">
    <div class="ba-container">
      <SectionHeader eyebrow="Values" title="Our Values" lead="Principles that shape relationships with clients, projects, and decisions." />
      <div class="values-layout">
        <div class="values-media">
          <img src="/assets/office/office-ba-brand.webp" alt="Bright Alliance | BA Chile office" loading="lazy" />
        </div>
        <div class="values-accordion">
          {content.valueDetails.map((value, index) => (
            <details class="value-card" open={index === 0}>
              <summary>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{value.title}</strong>
              </summary>
              <p>{value.text}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="ba-section offwhite founder-section">
    <div class="ba-container founder-layout">
      <div class="founder-copy">
        <span class="ba-label ba-eyebrow">Founding Partner</span>
        <h2>{content.founder.name}</h2>
        <p class="founder-role">{content.founder.role}</p>
        {content.founder.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <figure class="founder-small">
        <img src="/assets/website/jose-francisco-mazzei.png" alt="José Francisco Mazzei Alliende" loading="lazy" />
      </figure>
    </div>
  </section>

  <CTA
    lang="en"
    title="Let us discuss your next project"
    text="BA Chile works with a technical, sober, and business-oriented advisory logic."
    href="/en/contact/"
    label="Contact"
    agendaHref={contact.agendaHref}
  />
</BaseLayout>

<style>
  .portrait {
    aspect-ratio: 5 / 4;
  }

  .mission-card {
    padding: var(--ba-space-7);
    border-left: 4px solid var(--ba-gold-500);
    background: var(--ba-navy-900);
    color: var(--ba-white);
  }

  .mission-card h3 {
    margin: 0 0 var(--ba-space-3);
    color: var(--ba-gold-400);
    font-family: var(--ba-font-head);
    text-transform: uppercase;
  }

  .mission-card p {
    margin: 0 0 var(--ba-space-6);
  }

  .values-section {
    border-top: 1px solid var(--ba-gray-200);
  }

  .values-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: var(--ba-space-7);
    align-items: start;
  }

  .values-media {
    position: sticky;
    top: 112px;
    overflow: hidden;
    border: 1px solid var(--ba-gray-200);
    aspect-ratio: 4 / 5;
  }

  .values-media::after {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 96px;
    height: 4px;
    background: var(--ba-gold-500);
    content: '';
  }

  .values-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .values-accordion {
    display: grid;
    gap: var(--ba-space-3);
  }

  .founder-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: var(--ba-space-8);
    align-items: end;
  }

  .founder-copy h2 {
    margin: var(--ba-space-5) 0 var(--ba-space-3);
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-size: var(--ba-heading-xl);
  }

  .founder-copy p {
    max-width: 78ch;
  }

  .founder-role {
    color: var(--ba-gold-500);
    font-family: var(--ba-font-head);
    font-weight: 700;
  }

  .founder-small {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--ba-gray-200);
    background: var(--ba-white);
    aspect-ratio: 4 / 5;
  }

  .founder-small img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .value-card {
    border: 1px solid var(--ba-gray-200);
    background: var(--ba-white);
    color: var(--ba-gray-700);
  }

  .value-card summary {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr);
    gap: var(--ba-space-4);
    align-items: center;
    min-height: 64px;
    padding: var(--ba-space-5);
    cursor: pointer;
    list-style: none;
  }

  .value-card summary::-webkit-details-marker {
    display: none;
  }

  .value-card summary span {
    color: var(--ba-gold-500);
    font-family: var(--ba-font-head);
    font-size: 22px;
    font-weight: 700;
  }

  .value-card summary strong {
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-size: var(--ba-heading-md);
    font-weight: 600;
    text-transform: uppercase;
  }

  .value-card p {
    margin: 0;
    padding: 0 var(--ba-space-5) var(--ba-space-5) calc(var(--ba-space-5) + 70px);
  }

  .value-card[open] {
    border-color: rgba(179, 146, 89, 0.46);
    box-shadow: 0 22px 54px -42px rgba(16, 47, 75, 0.52);
  }

  .value-card[open] p {
    animation: value-open 320ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .value-card summary strong,
  .value-card summary span {
    transition: color var(--ba-ease), transform var(--ba-ease);
  }

  .value-card[open] summary strong {
    color: var(--ba-navy-900);
    transform: translateX(2px);
  }

  @keyframes value-open {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .value-card[open] p {
      animation: none;
    }

    .value-card summary strong,
    .value-card summary span {
      transition: none;
    }
  }

  @media (max-width: 860px) {
    .values-layout,
    .founder-layout {
      grid-template-columns: 1fr;
    }

    .values-media {
      position: relative;
      top: auto;
      aspect-ratio: 16 / 10;
    }

    .value-card p {
      padding-left: var(--ba-space-5);
    }
  }
</style>
