---
import ArticleDetail from '../components/ArticleDetail.astro';
import CTA from '../components/CTA.astro';
import ServiceDetailPage from '../components/ServiceDetailPage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { articles, contact, services } from '../content/site';

export function getStaticPaths() {
  return [
    ...services
      .filter((item) => item.lang === 'es' && !item.slug.startsWith('landing') && item.slug !== 'compliance')
      .map((page) => ({ params: { slug: page.slug }, props: { page, kind: 'service' } })),
    ...articles
      .filter((item) => item.lang === 'es')
      .map((page) => ({ params: { slug: page.slug }, props: { page, kind: 'article' } }))
  ];
}

const { page, kind } = Astro.props;
const isArticle = kind === 'article';
const ctaTitle = isArticle ? 'Conversemos sobre el impacto en su empresa' : page.cta;
const ctaText = isArticle
  ? 'Bright Alliance integra Derecho, Estrategia y Empresa para convertir complejidad jurídica en decisiones claras.'
  : page.ctaText ?? 'Bright Alliance integra Derecho, Estrategia y Empresa para convertir complejidad jurídica en decisiones claras.';
---

<BaseLayout title={`${page.title} - Bright Alliance | BA Chile`} description={page.summary} lang="es">
  {isArticle ? <ArticleDetail page={page} lang="es" /> : <ServiceDetailPage page={page} lang="es" />}

  <CTA title={ctaTitle} text={ctaText} href="/contacto/" label="Contactar" agendaHref={contact.agendaHref} lang="es" />
</BaseLayout>
