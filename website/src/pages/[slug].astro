---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CTA from '../components/CTA.astro';
import ArticleDetail from '../components/ArticleDetail.astro';
import { articles, contact, services } from '../content/site';

export function getStaticPaths() {
  return [
    ...services.filter((item) => item.lang === 'es' && !item.slug.startsWith('landing') && item.slug !== 'compliance').map((page) => ({ params: { slug: page.slug }, props: { page, kind: 'service' } })),
    ...articles.filter((item) => item.lang === 'es').map((page) => ({ params: { slug: page.slug }, props: { page, kind: 'article' } }))
  ];
}

const { page, kind } = Astro.props;
const isArticle = kind === 'article';
---

<BaseLayout title={`${page.title} - Bright Alliance | BA Chile`} description={page.summary} lang="es">
  {isArticle ? (
    <ArticleDetail page={page} lang="es" />
  ) : (
    <section class="service-hero">
      <img class="service-hero__image" src={page.heroImage || '/assets/office/office-private-room.webp'} alt={`Bright Alliance | BA Chile - ${page.navLabel}`} />
      <div class="service-hero__overlay"></div>
      <div class="ba-container service-hero__content">
        <h1>{page.title}</h1>
        <p class="service-hero__summary">{page.summary}</p>
        <p class="service-hero__intro">{page.intro}</p>
      </div>
    </section>
  )}

  {!isArticle && (
    <>
      <section class="ba-section light">
        <div class="ba-container ba-grid-2">
          <div>
            <h2 class="ba-heading-xl">{page.slug === 'derecho-de-la-empresa' ? 'Derecho, Estrategia y Empresa' : page.slug === 'comercio-y-negocios-internacionales' ? 'Acompañamos tu proceso de expansión' : 'Nuestros pilares'}</h2>
            {page.body.map((paragraph) => <p class="ba-body-lg">{paragraph}</p>)}
          </div>
          {page.models && (
            <div class="model-card">
              <h3>Modalidades de Asesoría</h3>
              <ul class="ba-list">
                {page.models.map((model) => <li>{model}</li>)}
              </ul>
            </div>
          )}
        </div>
      </section>

      {page.pillars && (
        <section class="ba-section offwhite service-pillars">
          <div class="ba-container">
            <SectionHeader eyebrow="Criterio de trabajo" title="Una práctica orientada a decisiones empresariales" lead="Cada línea de servicio se organiza desde una lectura legal, estratégica y operativa." />
            <div class="pillar-grid">
              {page.pillars.map((pillar, index) => (
                <article class="pillar-card">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <h3>{pillar.title}</h3>
                  <p>{pillar.text}</p>
                </article>
              ))}
            </div>
          </div>
        </section>
      )}

      {page.sections && (
        <section class="ba-section light service-detail">
          <div class="ba-container">
            <SectionHeader eyebrow="Alcance" title="Contenido del servicio" lead="Síntesis adaptada desde la información pública vigente de BA Chile." />
            <div class="service-detail__list">
              {page.sections.map((section, index) => (
                <article class="detail-item">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <div>
                    <h3>{section.title}</h3>
                    <p>{section.text}</p>
                    {section.paragraphs && section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                    {section.items && (
                      <ul class="ba-list">
                        {section.items.map((item) => <li>{item}</li>)}
                      </ul>
                    )}
                    {section.result && <p class="detail-item__result">{section.result}</p>}
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      )}

      <section class="ba-section offwhite">
        <div class="ba-container">
          <SectionHeader eyebrow="Áreas" title={page.slug.includes('landing') ? 'Ámbitos de asesoría' : 'Áreas de especialización'} lead="Materias organizadas para una lectura ejecutiva y accionable." />
          <div class="area-grid">
            {page.areas.map((area, index) => (
              <div class="area-item">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <p>{area}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    </>
  )}

  <CTA title={isArticle ? 'Conversemos sobre el impacto en su empresa' : page.cta} text="Bright Alliance integra Derecho, Estrategia y Empresa para convertir complejidad jurídica en decisiones claras." href="/contacto/" label="Contactar" agendaHref={contact.agendaHref} />
</BaseLayout>

<style>
  .service-hero {
    position: relative;
    display: grid;
    min-height: 720px;
    overflow: hidden;
    color: var(--ba-white);
  }

  .service-hero__image,
  .service-hero__overlay {
    position: absolute;
    inset: 0;
  }

  .service-hero__image {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .service-hero__overlay {
    background:
      linear-gradient(90deg, rgba(5, 14, 23, 0.72) 0%, rgba(16, 47, 75, 0.50) 46%, rgba(16, 47, 75, 0.32) 100%),
      linear-gradient(180deg, rgba(5, 14, 23, 0.22) 0%, rgba(5, 14, 23, 0.54) 100%);
  }

  .service-hero__content {
    position: relative;
    z-index: 1;
    align-self: center;
    padding-top: var(--ba-header-expanded);
  }

  .service-hero h1 {
    max-width: 920px;
    margin: 0 0 var(--ba-space-5);
    color: var(--ba-white);
    font-family: var(--ba-font-head);
    font-size: var(--ba-display-xl);
    font-weight: 700;
    line-height: 1.08;
  }

  .service-hero__summary {
    max-width: 760px;
    margin: 0 0 var(--ba-space-4);
    color: var(--ba-white);
    font-family: var(--ba-font-head);
    font-size: clamp(19px, 1.65vw, 25px);
    font-weight: 700;
    line-height: 1.45;
  }

  .service-hero__intro {
    max-width: 900px;
    margin: 0;
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(17px, 1.35vw, 21px);
    line-height: 1.65;
  }

  .model-card {
    padding: var(--ba-space-7);
    border-left: 4px solid var(--ba-gold-500);
    background: var(--ba-navy-900);
    color: var(--ba-white);
    box-shadow: 0 28px 70px -50px rgba(16, 47, 75, 0.72);
  }

  .model-card .ba-list li {
    margin-bottom: var(--ba-space-4);
    color: rgba(255, 255, 255, 0.88);
    font-family: var(--ba-font-head);
    font-weight: 600;
  }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--ba-space-5);
  }

  .pillar-card {
    min-height: 260px;
    padding: var(--ba-space-7);
    border: 1px solid rgba(16, 47, 75, 0.12);
    background: var(--ba-white);
  }

  .pillar-card span,
  .detail-item > span {
    color: var(--ba-gold-500);
    font-family: var(--ba-font-head);
    font-size: 24px;
    font-weight: 700;
  }

  .pillar-card h3,
  .detail-item h3 {
    margin: var(--ba-space-4) 0 var(--ba-space-3);
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-size: var(--ba-heading-md);
    font-weight: 600;
  }

  .pillar-card p,
  .detail-item p {
    margin: 0;
  }

  .service-detail__list {
    display: grid;
    gap: var(--ba-space-5);
  }

  .detail-item {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: var(--ba-space-5);
    padding: var(--ba-space-7);
    border-top: 1px solid var(--ba-gray-200);
    background: linear-gradient(180deg, rgba(16, 47, 75, 0.018), rgba(16, 47, 75, 0));
  }

  .detail-item .ba-list {
    margin-top: var(--ba-space-5);
  }

  .detail-item__result {
    margin-top: var(--ba-space-5) !important;
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-weight: 600;
  }

  .model-card h3 {
    margin: 0 0 var(--ba-space-5);
    color: var(--ba-gold-400);
    font-family: var(--ba-font-head);
    text-transform: uppercase;
  }

  .area-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--ba-space-5);
  }

  .area-item {
    min-height: 150px;
    padding: var(--ba-space-6);
    border: 1px solid var(--ba-gray-200);
    background: var(--ba-white);
  }

  .area-item span {
    display: block;
    margin-bottom: var(--ba-space-4);
    color: var(--ba-gold-500);
    font-family: var(--ba-font-head);
    font-size: 30px;
    font-weight: 900;
    line-height: 1;
  }

  .area-item p {
    margin: 0;
    color: var(--ba-navy-900);
    font-family: var(--ba-font-head);
    font-weight: 700;
    line-height: 1.35;
  }

  .article-body img {
    width: 100%;
    margin-bottom: var(--ba-space-7);
    border: 1px solid var(--ba-gray-200);
  }

  .article-body p {
    font-size: var(--ba-body-lg);
  }

  @media (max-width: 860px) {
    .pillar-grid {
      grid-template-columns: 1fr;
    }

    .area-grid {
      grid-template-columns: 1fr;
    }

    .detail-item {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .service-hero {
      min-height: 640px;
    }

    .service-hero h1 {
      font-size: 40px;
    }

    .service-hero__summary {
      font-size: 19px;
    }
  }
</style>
