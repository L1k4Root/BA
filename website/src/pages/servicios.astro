---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeServices from '../components/HomeServices.astro';
import CTA from '../components/CTA.astro';
import { contact, home, servicesByLang } from '../content/site';

const lang = 'es';
const services = servicesByLang(lang).filter((service) => !service.slug.startsWith('landing') && service.slug !== 'compliance');
const content = home[lang];
---

<BaseLayout title="Servicios - Bright Alliance | BA Chile" description={content.servicesSubheading} lang={lang}>
  <HomeServices heading="Áreas de especialidad" subheading="Tres frentes de asesoría jurídico-estratégica para empresas, proyectos y operaciones que requieren criterio legal y visión de negocio." services={services} />

  <CTA
    title="Conversemos sobre el área que necesita fortalecer"
    text="Podemos revisar estructura, contratos, proyectos, expansión internacional o continuidad jurídica desde una perspectiva ejecutiva."
    href="/contacto/"
    label="Contactar"
    agendaHref={contact.agendaHref}
  />
</BaseLayout>
